.Rhistory
.RData
.Rapp.history
.Rproj.user/
*.Rproj

# profiler output
*.Rprof
prof_*.out

# Generated pipeline output - regenerate with run_pipeline.R.
# Not tracked: these are derived from the tracked sources, and git history
# now provides the regression baseline they used to serve as (check out an
# older commit and re-run to reproduce any previous output).
script_out.txt
script_out2.txt
scratch_full_out.qvs
formatexample_after.txt
script_qvs_out.txt

# benchmark / profiling scratch
chunk_timings.rds

# Claude Code settings that are local to this machine
.claude/settings.local.json

# Per-machine qlik-cli location and probe output. The path differs on every VM,
# so it is never tracked - qlik_cli_path.txt.example IS tracked as the template.
qlik_cli_path.txt
qlik_probe_out/

# Generated migration reports - regenerate with render_report.R.
report_app*.html
*-report.html

# Repo tidy-up (Adam 2026-08-21): this is a solo-dev repo, git is used purely
# as a delivery mechanism to get scripts onto VMs that never commit or push.
# Dev/test-only files stay on disk and stay usable here - they are just no
# longer tracked, so a VM operator browsing GitHub isn't wading through them.
# [Grant Managing Region].txt stays TRACKED on purpose - kept version
# controlled and available for VM-side troubleshooting even though unlikely
# to be needed.

# Example report output.
report_mock.html

# Example app folders.
app-unbuilt/
app2-unbuilt/

# Dev-only pipeline gate - never run on a VM, only before a push here.
verify.R

# Workflow docs other than README.md.
CLAUDE.md
DESIGN.md
INTERFACES.md
STATE.md
PLAN-comment-substream.md
dlmf-log.md
