# What stays on the machine and never goes into git. git is only the way the
# scripts reach the VM; run output, tenant content and dev notes stay local.

# What a migration run writes (one folder per app, plus migrated_apps.csv)
output/

# R session leftovers
.Rhistory
.RData
.Rapp.history
.Rproj.user/
*.Rproj
*.Rprof

# Claude Code settings for this machine, and the dev session rules
.claude/settings.local.json
CLAUDE.md

# docs/ is its own LOCAL-ONLY git repo (design notes, decisions). Never give
# it a remote.
docs/

# Dev-PC data, kept locally, never shipped
fixtures/
