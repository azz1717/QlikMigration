///$tab Other ABS Boundaries
[SA1 2021 - ILOC 2021]:
LOAD
    "SA1 2021 - ILOC 2021.SA1 Code" as [SA1 Code],
    "SA1 2021 - ILOC 2021.Indigenous Location Code" as [ILOC Code]
//     "SA1 2021 - ILOC 2021.Indigenous Location",
//     "SA1 2021 - ILOC 2021.Indigenous Area Code",
//     "SA1 2021 - ILOC 2021.Indigenous Area",
//     "SA1 2021 - ILOC 2021.Indigenous Region Code",
//     "SA1 2021 - ILOC 2021.Indigenous Region",
//     "SA1 2021 - ILOC 2021.Australian State Code",
//     "SA1 2021 - ILOC 2021.Australian State",
//     "SA1 2021 - ILOC 2021.Country Code",
//     "SA1 2021 - ILOC 2021.Country",
//     "SA1 2021 - ILOC 2021.Area Sq Km" as [ILOC Area Sq Km]
//     "SA1 2021 - ILOC 2021.Locality URL"
FROM [lib://AppDataProd/Geospatial/SA1 2021 - ILOC 2021.qvd]
(qvd);

[MB 2021]:
LOAD
    "MB 2021.Id",
    "MB 2021.Mesh Block Code" as [MB Code],
//     "MB 2021.Mesh Block Category",
//     "MB 2021.Change Flag",
//     "MB 2021.Changed",
    "MB 2021.SA1 Code" as [SA1 Code],
    "MB 2021.SA2 Code" as [SA2 Code]
//     "MB 2021.SA2 Name",
//     "MB 2021.SA3 Code",
//     "MB 2021.SA3 Name",
//     "MB 2021.SA4 Code",
//     "MB 2021.SA4 Name",
//     "MB 2021.GCC Code",
//     "MB 2021.GCC Name",
//     "MB 2021.Australian State Code",
//     "MB 2021.Australian State",
//     "MB 2021.Country Code",
//     "MB 2021.Country",
//     "MB 2021.Area Sq Km",
//     "MB 2021.Locality URL"
FROM [lib://AppDataProd/Geospatial/MB 2021.qvd]
(qvd);



[SA2]:
LOAD
//     "SA2 2021.Id",
    "SA2 2021.SA2 Code" as [SA2 Code],
    "SA2 2021.SA2 Name" as [SA2 Name],
//     "SA2 2021.SA3 Code",
//     "SA2 2021.SA3 Name",
//     "SA2 2021.SA4 Code",
//     "SA2 2021.SA4 Name",
//     "SA2 2021.GCCSA Code",
//     "SA2 2021.GCCSA Name",
//     "SA2 2021.Australian State Code",
//     "SA2 2021.Australian State",
//     "SA2 2021.Country Code",
//     "SA2 2021.Country",
    "SA2 2021.Area Sq Km" as [SA2 Area Sq Km],
//     "SA2 2021.Locality URL",
//     "SA2 2021.Change Code",
//     "SA2 2021.Change",
//     "SA2 2021.SimplifiedGeometryWKT",
    "SA2 2021.Geometry" as [SA2 Geometry]
FROM [lib://AppDataProd/Geospatial/SA2 2021.qvd]
(qvd);




///$tab Region & Subregion
[NIAA Region]:
LOAD
    "NIAA Region 2024.NIAA Region Id" as [NIAA Region Id],
    "NIAA Region 2024.NIAA Region" as [NIAA Region Name],
    If(match("NIAA Region 2024.NIAA Region",'Arnhem Land & Groote Eylandt','Central','Top End & Tiwi Islands'),'Central',
    	If(match("NIAA Region 2024.NIAA Region",'Eastern New South Wales','North Queensland','South Queensland','Western New South Wales'),'Eastern',
        	If(match("NIAA Region 2024.NIAA Region",'Greater Western Australia','Kimberley','South Australia','Victoria & Tasmania'	),'West and South Group','Unknown'))) as [Region Group],
    "NIAA Region 2024.Geometry" as [NIAA Region Geometry]
FROM [lib://AppData/PROD/Geospatial/NIAA Region 2024.qvd]
(qvd);


[NIAA Subregion]:
LOAD
    "NIAA Subregion 2024.NIAA Subregion Id" as [NIAA Subregion Id],
    "NIAA Subregion 2024.NIAA Region" as [NIAA Region Name],
    "NIAA Subregion 2024.NIAA Subregion" as [NIAA Subregion Name],
    "NIAA Subregion 2024.Geometry" as [NIAA Subregion Geometry]
FROM [lib://AppData/PROD/Geospatial/NIAA Subregion 2024.qvd]
(qvd);




[ILOC - NIAA Subregion]:
LOAD
    "ILOC 2021 - NIAA Subregion 2024.ILOC Code" as [ILOC Code],
//     "ILOC 2021 - NIAA Subregion 2024.Indigenous Location",
    "ILOC 2021 - NIAA Subregion 2024.NIAA Subregion" as [NIAA Subregion Name]
//     "ILOC 2021 - NIAA Subregion 2024.NIAA Region"
FROM [lib://AppData/PROD/Geospatial/ILOC 2021 - NIAA Subregion 2024.qvd]
(qvd);







