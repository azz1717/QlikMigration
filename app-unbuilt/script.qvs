///$tab NT Admin
[NT Admin Region 2023]:
LOAD
    "NT Admin Region 2023.Id" as [NT Admin Id],
    "NT Admin Region 2023.Region" as [NT Admin Region],
//     "NT Admin Region 2023.Australian State Code",
//     "NT Admin Region 2023.Australian State",
//     "NT Admin Region 2023.Country Code",
//     "NT Admin Region 2023.Country",
//     "NT Admin Region 2023.SimplifiedGeometryWKT",
    "NT Admin Region 2023.Geometry" as [NT Admin Geometry]
FROM [lib://AppDataProd/Geospatial/NT Admin Region 2023.qvd]
(qvd);


[MB 2021 - NT Admin Region 2023]:
LOAD
    "MB 2021 - NT Admin Region 2023.Mesh Block Code" as [MB Code],
    "MB 2021 - NT Admin Region 2023.Id" as [NT Admin Id]
//     "MB 2021 - NT Admin Region 2023.Region"
FROM [lib://AppDataProd/Geospatial/MB 2021 - NT Admin Region 2023.qvd]
(qvd);


///$tab NACCHO
[NACCHO Locations]:
LOAD
    "NACCHO Member Name" as [NACCHO Member Name],
    Address as [NACCHO Address],
    "City/Suburb" as [NACCHO City/Suburb],
    State as [NACCHO State],
//     Latitude as [NACCHO Latitude],
//     Longitude as [NACCHO Longitude],
    GeoMakePoint("Latitude", "Longitude") AS [NACCHO Location],
    "Address Url For Geocode Succeess Level" as [NACCHO Geocode Success Level],
//     "Mesh Block Code 2016",
    "Mesh Block Code 2021" as [MB Code]
FROM [lib://AppData/PROD/AzureDataLake/NACCHO/Member Name Locations.qvd]
(qvd);


///$tab SA Locations
[Services Australia Offices]:
LOAD
    "OFFICE TYPE" as [SA Office Type],
    ID as [SA Id],
    NAME as [SA Name],
    ROC as [SA ROC],
    ADDRESS1 as [SA Address1],
    ADDRESS2 as [SA Address2],
    SUBURB as [SA Suburb],
    STATE as [SA State],
    POSTCODE as [SA Postcode],
    COUNTRY as [SA Country],
//     LATITUDE as [SA Latitude],
//     LONGITUDE as [SA Longitude],
    GeoMakePoint(LATITUDE, LONGITUDE) AS [SA Office Location],
    MESH_BLOCK_CODE_2021 as [MB Code]
FROM [lib://AppDataProd/AzureDataLake/DGOV/Services Australia Offices.qvd]
(qvd);


