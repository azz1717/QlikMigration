// 	Homeless_ATSI_Perc, 
	CtG5_Attained_Year_12, 
// 	CtG5_Attained_Year_12_Perc, 
	CtG5_Total_applicable_population_aged_20_24_years, 
	CtG6_Completed_Certificate_III, 
// 	CtG6_Completed_Certificate_III_Perc, 
	CtG6_Total_applicable_population_aged_25_34_years, 
	CtG7_Fully_engaged, 
// 	CtG7_Fully_engaged_Perc, 
	CtG7_Total_applicable_population_aged_15_24_years, 
	CtG8_Employed, 
// 	CtG8_Employed_Perc, 
	CtG8_Total_applicable_population_aged_25_64_years_no, 
	CtG9A_Living_in_appropriately_sized, 
// 	CtG9A_Living_in_appropriately_sized_Perc, 
