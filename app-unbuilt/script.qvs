//Get the data for the hubs above
[Hub]:
load 
[Office Name],
'Yes' as [Hub],
[Hub ILOC]
resident [HubTemp];

Left Join
LOAD
    [Office Name],
    "Site Locations Latitude" as [Hub Latitude],
    "Site Locations Longitude" as [Hub Longitude]
Resident [NIAA Office Locations];



//Manualy add in any new hub sites
Concatenate Load * Inline [
Office Name, Hub, Hub ILOC, Hub Longitude, Hub Latitude
Bourke, Yes, Bourke, 145.9356, -30.073246
Napranum, Yes, Napranum, 141.8883, -12.683697
Normanton, Yes, Normanton, 141.0417, -17.724606 
Port Kennedy (Thursday Island), Yes, Port Kennedy (Thursday Island), 142.2155, -10.554585
];


drop table [HubTemp];






//Spokes
//Do a closest between the hubs and the ILOC Centroid/Center


LIB CONNECT TO 'GeoAnalytics Direct';

/* Generated by GeoAnalytics for operation Closest ---------------------- */
[_inlineMap_]:
mapping LOAD * inline [
_char_, _utf_
"'", '\u0027'
'"', '\u0022'
"[", '\u005b'
"/", '\u002f'
"*", '\u002a'
";", '\u003b'
"}", '\u007d'
"{", '\u007b'
"`", '\u0060'
"´", '\u00b4'
"	", '\u0009'
];

IF FieldNumber('ILOC Code', 'ILOC 2021') = 0 THEN
	call InvalidInlineData('The field ILOC Code in ILOC 2021 is not available');
END IF
IF FieldNumber('ILOC Center', 'ILOC 2021') = 0 THEN
	call InvalidInlineData('The field ILOC Center in ILOC 2021 is not available');
END IF
Let [ILOCsInlineTable] = 'ILOC Code' & Chr(9) & 'ILOC Center';
Let numRows = NoOfRows('ILOC 2021');
Let chunkSize = 1000;
Let chunks = numRows/chunkSize;
For n = 0 to chunks
	Let chunkText = '';
	Let chunk = n*chunkSize;
	For i = 0 To chunkSize-1
		Let row = '';
		Let rowNr = chunk+i;
		Exit for when rowNr >= numRows;
		For Each f In 'ILOC Code', 'ILOC Center'
			row = row & Chr(9) & MapSubString('_inlineMap_', Peek('$(f)', $(rowNr), 'ILOC 2021'));
		Next
		chunkText = chunkText & Chr(10) & Mid('$(row)', 2);
	Next
	[ILOCsInlineTable] = [ILOCsInlineTable] & chunkText;
Next
chunkText=''
[_inlineMap_]:
mapping LOAD * inline [
_char_, _utf_
"'", '\u0027'
'"', '\u0022'
"[", '\u005b'
"/", '\u002f'
"*", '\u002a'
";", '\u003b'
"}", '\u007d'
"{", '\u007b'
"`", '\u0060'
"´", '\u00b4'
"	", '\u0009'
];

IF FieldNumber('Office Name', 'Hub') = 0 THEN
	call InvalidInlineData('The field Office Name in Hub is not available');
END IF
IF FieldNumber('Hub Latitude', 'Hub') = 0 THEN
	call InvalidInlineData('The field Hub Latitude in Hub is not available');
END IF
IF FieldNumber('Hub Longitude', 'Hub') = 0 THEN
	call InvalidInlineData('The field Hub Longitude in Hub is not available');
END IF
Let [HubsInlineTable] = 'Office Name' & Chr(9) & 'Hub Latitude' & Chr(9) & 'Hub Longitude';
Let numRows = NoOfRows('Hub');
Let chunkSize = 1000;
Let chunks = numRows/chunkSize;
For n = 0 to chunks
	Let chunkText = '';
	Let chunk = n*chunkSize;
	For i = 0 To chunkSize-1
		Let row = '';
		Let rowNr = chunk+i;
		Exit for when rowNr >= numRows;
		For Each f In 'Office Name', 'Hub Latitude', 'Hub Longitude'
			row = row & Chr(9) & MapSubString('_inlineMap_', Peek('$(f)', $(rowNr), 'Hub'));
		Next
		chunkText = chunkText & Chr(10) & Mid('$(row)', 2);
	Next
	[HubsInlineTable] = [HubsInlineTable] & chunkText;
Next
chunkText=''


[ILOC to Hub Temp]:
SQL SELECT [ILOCs_Hubs_RelationId], [ILOC Code], [Office Name], [ILOCs_Hubs_Distance], [ILOCs_Hubs_Route] FROM Closest(costUnit='Kilometers', distance='1000', distanceType='car', closestCount='1', dataset1='ILOCs', dataset2='Hubs')
DATASOURCE ILOCs INLINE tableName='ILOC 2021', tableFields='ILOC Code,ILOC Center', geometryType='POINT', loadDistinct='NO', suffix='', crs='Auto' {$(ILOCsInlineTable)}
DATASOURCE Hubs INLINE tableName='Hub', tableFields='Office Name,Hub Latitude,Hub Longitude', geometryType='POINTLATLON', loadDistinct='NO', suffix='', crs='Auto' {$(HubsInlineTable)}
;
tag field [ILOCs_Hubs_RelationId] with '$primarykey';
tag field [ILOCs_Hubs_Route] with '$geoline';
tag field [ILOCs_Hubs_RelationId] with '$geoname';
tag field [ILOCs_Hubs_Route] with '$relates_ILOCs_Hubs_RelationId';
tag field [ILOCs_Hubs_RelationId] with '$relates_ILOCs_Hubs_Route';

[ILOCsInlineTable] = '';
[HubsInlineTable] = '';

/* End GeoAnalytics operation Closest ----------------------------------- */

left join load 
[Office Name],
[NIAA Site Location]
resident [NIAA Office Locations];

[ILOC to Hub]:
noconcatenate load
autonumber([ILOC Code]) as [Closest Office to ILOC Id],
[ILOC Code],
[Office Name] as [Closest Office to ILOC Name],
[NIAA Site Location] as [Closest Office to ILOC Location],
[ILOCs_Hubs_Distance] as [Closest Office to ILOC Distance Kms],
[ILOCs_Hubs_Route] as [Closest Route ILOC to Office]
resident [ILOC to Hub Temp];

drop table [ILOC to Hub Temp];



///$tab OLDFleet
//Gets the start and end points
[Fleet trips]:
LOAD
    "Fleet Detail.Fleet Trip Id" as [shape_pt_sequence],
//     "Fleet Detail.Vehicle",
    "Fleet Detail.Registration" as [Fleet Car Rego],
//     "Fleet Detail.VehicleGroup",
	"Fleet Detail.ActivityDate" as [Activity Date],
// 	Date#("Fleet Detail.ActivityDate", 'DD/MM/YYYY') as [Activity Date],
//     Year(Date#("Fleet Detail.ActivityDate", 'DD/MM/YYYY'))&'-'&num(Month(Date#("Fleet Detail.ActivityDate", 'DD/M/YYYY'))) as [Fleet Activity YearMonth],
    Year("Fleet Detail.ActivityDate") as [Fleet Activity Year],
    Month("Fleet Detail.ActivityDate") as [Fleet Activity Month],
//     Month(Date#("Fleet Detail.ActivityDate", 'DD/M/YYYY')) as [Activity Month],
//     "Fleet Detail.EventType",
//     "Fleet Detail.EventTime",
//     "Fleet Detail.TripDistance",
//     "Fleet Detail.TripUnit",
//     "Fleet Detail.OnSiteTime",
//     "Fleet Detail.HDOP",
//     "Fleet Detail.NumSatellites",
//     "Fleet Detail.Channel",
//     "Fleet Detail.Location",
    "Fleet Detail.Latitude" as shape_pt_lat,
    "Fleet Detail.Longitude" as shape_pt_lon
FROM [lib://AppDataProd/AzureDataLake/NIAA/Fleet Detail.qvd]
(qvd)
//Leave out the tiny trips
where "Fleet Detail.TripDistance" > '1.4'
//leave out some bogus coords
and "Fleet Detail.Latitude" < '0.0'
and "Fleet Detail.Longitude" > '0.0'
//Leave out where car coords revert to Sydney CBD
and not match("Fleet Detail.Latitude", '-33.81163','-33.81155')
and not match("Fleet Detail.Longitude",'150.91871','150.91862')
and not match("Fleet Detail.Fleet Trip Id", '841673','755367','755368','755369','755370','755371','755372',
'20043','20044','20049'
,'757619','757622','757623','757624'
,'784700','784701','784702','784703','784704','784705','784706','784707','784708','784709','784710','784711','784712','784713','784714','784715','784716','784717','784718','784719','784720','784721','784722','784723','784724','784725','784726'
)
;


// exit script;



//Turns the start and ends into lines sequentially
[Lines]:
LOAD 	[Fleet Car Rego],
		[Fleet Activity Year],

[Fleet Car Rego] * 10000 + shape_pt_sequence as shape_seg_id,

GeoMakePoint(shape_pt_lat,shape_pt_lon) as shape_pt,

[shape_pt_sequence]

Resident [Fleet trips];
drop table [Fleet trips];



//Puts the lines together so there is only one per Rego
TempFleetGPS:
load

Distinct 	[Fleet Car Rego],
			[Fleet Activity Year],

'[' & concat(shape_pt,',',shape_pt_sequence) & ']' as FleetLine

Resident Lines

group by [Fleet Car Rego], [Fleet Activity Year];

drop table Lines;


FleetGPS:
Load
*,
Autonumber([Fleet Car Rego]&[Fleet Activity Year]) as RegYearKey
resident TempFleetGPS
;

drop table TempFleetGPS
;








//These are the records of the actual cars - they join to Sites using FleetALC (which is duplicated on the Site side from ALC to avoid circular references)
[Fleet Cars]:
LOAD
    "Fleet.Fleet Id" as [Fleet ID],
    Fleet.Rego as [Fleet Car Rego],
    Fleet.Make as [Make],
    Fleet.Model as [Model],
    Fleet.Group as [Fleet Group],
    Fleet.Car_Location as [Fleet Car Locations],
    "Fleet.Aurion Location Code" as [Aurion Location Code]
FROM [lib://AppDataProd/AzureDataLake/NIAA/Fleet.qvd]
(qvd);



[Fleet Stops]:
LOAD
    Autonumber("Fleet Detail.Registration"&"Fleet Detail.ActivityDate"&"Fleet Detail.OnSiteTime"&"Fleet Detail.Latitude"&"Fleet Detail.Longitude") as FleetStopId,
	Autonumber("Fleet Detail.Registration"&Year("Fleet Detail.ActivityDate")) as RegYearKey,
	"Fleet Detail.Registration" as [Fleet Car Reg],
//     "Fleet Detail.VehicleGroup",
    "Fleet Detail.ActivityDate" as [Fleet Stop Date],
    Year("Fleet Detail.ActivityDate") as [Fleet Stop Year],
//     "Fleet Detail.EventType",
//     "Fleet Detail.EventTime",
//     "Fleet Detail.TripDistance",
//     "Fleet Detail.TripUnit",
    "Fleet Detail.OnSiteTime" as [Fleet Stop Time],
//     "Fleet Detail.HDOP",
//     "Fleet Detail.NumSatellites",
//     "Fleet Detail.Channel",
//     "Fleet Detail.Location",
//     "Fleet Detail.Latitude" as [Fleet Stop Lat],
//     "Fleet Detail.Longitude" as [Fleet Stop Lon],
    GeoMakePoint("Fleet Detail.Latitude","Fleet Detail.Longitude") as [Stop Location]
FROM [lib://AppDataProd/AzureDataLake/NIAA/Fleet Detail.qvd]
(qvd)
// where not IsNull("Fleet Detail.OnSiteTime")
// and not match("Fleet Detail.OnSiteTime", 'Unknown','01 min')
where wildmatch( "Fleet Detail.OnSiteTime", '*hr*')
;



































