///$tab AEDC
[AEDC_2021_Student]:

LOAD
    AEDC_2021_Student.Year&'-'&"AEDC_2021_Student.Student Id%" as [Unique Id%],
    AEDC_2021_Student.Year as [Year],
//     AEDC_2021_Student.Cycle,
    "AEDC_2021_Student.Student Id%" as [Student Id%],
    "AEDC_2021_Student.School Id%" as [School Id%],
    "AEDC_2021_Student.School Type" as [School Type],
    "AEDC_2021_Student.School State" as [School State],
    "AEDC_2021_Student.Resident State" as [Resident State],
    "AEDC_2021_Student.Teacher Id%" as [Teacher Id%],
    "AEDC_2021_Student.Teacher ATSI" as [Teacher ATSI],
    "AEDC_2021_Student.Assisted by Indigenous Consultant" as [Assisted by Indigenous Consultant],
    "AEDC_2021_Student.Teacher can accurately assess child" as [Teacher can accurately assess child],
    AEDC_2021_Student.Gender as [Gender],
    AEDC_2021_Student.Age as [Age],
    "AEDC_2021_Student.Special Needs" as [Special Needs],
    AEDC_2021_Student.ATSI as [ATSI],
    "AEDC_2021_Student.ATSI Type" as [ATSI Type],
    AEDC_2021_Student.ESL as [ESL],
//     "AEDC_2021_Student.ILOC Code" as [ILOC Code],
    "AEDC_2021_Student.ILOC Code" as [ILOC Code],
    "AEDC_2021_Student.Having Developmental Difficulties" as [Having Developmental Difficulties],
    "AEDC_2021_Student.PHYS Score" as [PHYS Score],
    "AEDC_2021_Student.SOC Score" as [SOC Score],
    "AEDC_2021_Student.EMOT Score" as [EMOT Score],
    "AEDC_2021_Student.LANGCOG Score" as [LANGCOG Score],
    "AEDC_2021_Student.COMGEN Score" as [COMGEN Score],
    "AEDC_2021_Student.PHYS Valid" as [PHYS Valid],
    "AEDC_2021_Student.SOC Valid" as [SOC Valid],
    "AEDC_2021_Student.EMOT Valid" as [EMOT Valid],
    "AEDC_2021_Student.LANGCOG Valid" as [LANGCOG Valid],
    "AEDC_2021_Student.COMGEN Valid" as [COMGEN Valid],
    "AEDC_2021_Student.Valid Instrument" as [Valid Instrument],
    "AEDC_2021_Student.PHYS Category" as [PHYS Category],
    "AEDC_2021_Student.SOC Category" as [SOC Category],
    "AEDC_2021_Student.EMOT Category" as [EMOT Category],
    "AEDC_2021_Student.LANGCOG Category" as [LANGCOG Category],
    "AEDC_2021_Student.COMGEN Category" as [COMGEN Category],
    "AEDC_2021_Student.Total Vulnerable Domains" as [Total Vulnerable Domains],
    "AEDC_2021_Student.Total On Track Domains" as [Total On Track Domains]
    ,
//     "AEDC_2021_Student.DV1 Flag",
//     "AEDC_2021_Student.DV2 Flag",
    "AEDC_2021_Student.OT5 Flag" as [OT5 Flag],
//     AEDC_2021_Student.DV1,
//     AEDC_2021_Student.DV2,
    AEDC_2021_Student.OT5 as [OT5],
//     "AEDC_2021_Student.On Track 0",
//     "AEDC_2021_Student.On Track 1",
//     "AEDC_2021_Student.On Track 2",
//     "AEDC_2021_Student.On Track 3",
//     "AEDC_2021_Student.On Track 4",
//     "AEDC_2021_Student.On Track 5",
    AEDC_2021_Student.MSI as [MSI],
    "AEDC_2021_Student.MSI Valid" as [MSI Valid],
    "AEDC_2021_Student.MSI Category" as [MSI Category]
FROM [lib://AppDataProd/AzureDataLake/AEDC/AEDC_2021_Student.qvd]
(qvd)
where [AEDC_2021_Student.Year] <> '2010' //2010 seems empty dont know what its doing here - 5 domain categories are all 'unknown'
;




[CrossTab]:
crosstable (Category, Result) 
LOAD 
[Unique Id%],
[PHYS Category] as [Physical health and wellbeing],
[SOC Category] as [Social competence],
[EMOT Category] as [Emotional maturity],
[LANGCOG Category] as [Language and cognitive skills],
[COMGEN Category] as [Communication and general knowledge]
resident [AEDC_2021_Student]
;



[Results]:
NoConcatenate Load *
resident [CrossTab]
where Result <> 'Unknown'
;
Drop table [CrossTab];










