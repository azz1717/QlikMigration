    "Indigenous Land Use Agreement.Date Extracted" as [ILUA Date Extracted],
    "Indigenous Land Use Agreement.Geometry" as [ILUA Geometry]
FROM [lib://AppDataProd/Geospatial/Indigenous Land Use Agreement.qvd]
(qvd);




