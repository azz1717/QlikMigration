///$tab Milestone
//Let vDaysoverdue = 'IF([Milestone Expected Due Date] <= today(), Today() - [Milestone Expected Due Date])' ;
Let vEndDate = text('2014-06-30');
Let vFinYear = Replace(YearName(Today(),0,7), '-20','-');
Let vFinYear1 = Replace(YearName(AddMonths(Today(),-12),0,7), '-20','-');
Let vFinYear2 = Replace(YearName(AddMonths(Today(),-24),0,7), '-20','-');
Let vCurMonth = Month(AddMonths(Today(),0));


[Grant Activity Milestone Temp]:
LEFT Keep ([Grant Activity])
LOAD
    "Grant Activity Milestone.Milestone Id"																	AS [Milestone Id],
    "Grant Activity Milestone.Grant Activity Milestone Id"													AS [Activity Milestone Id%],
    "Grant Activity Milestone.Activity Id"																	AS [Activity Id],
    "Grant Activity Milestone.Milestone Expected Due Date"													AS [Milestone Expected Due Date],
    "Grant Activity Milestone.Milestone Days Overdue"														AS [Milestone Days Overdue],  
    "Grant Activity Milestone.Milestone Financial Year"														AS [Milestone Financial Year],			
    "Grant Activity Milestone.Milestone Status"																AS [Milestone Status],	
    "Grant Activity Milestone.Milestone Stage"																AS [Milestone Stage],	
    "Grant Activity Milestone.Milestone Received"															AS [Milestone Received],		
    "Grant Activity Milestone.Milestone Received Date"														AS [Milestone Received Date],			
    "Grant Activity Milestone.Milestone Completed Indicator"												AS [Milestone Completed],					
    "Grant Activity Milestone.Milestone Completion Date"													AS [Milestone Completion Date],				
    "Grant Activity Milestone.Milestone Payment Mode"														AS [Milestone Payment Mode],	
    "Grant Activity Milestone.Milestone Review Type"														AS [Milestone Review Type],
    "Grant Activity Milestone.Milestone Type"																AS [Milestone Type],	
    "Grant Activity Milestone.Milestone Long Description"													AS [Milestone Long Description],				
    "Grant Activity Milestone.Milestone Short Description"   												AS [Milestone Short Description],				
    "Grant Activity Milestone.Milestone Completion Description"												AS [Milestone Completion Description],					
    "Grant Activity Milestone.Milestone Action Required"													AS [Milestone Action Required],				
    "Grant Activity Milestone.Milestone Actual Amount Ex GST"												AS [Milestone Actual Amount Ex GST],					
//    "Grant Activity Milestone.Activity IMPACT PO Id"														AS [Activity IMPACT PO Id],			
    "Grant Activity Milestone.Milestone Auto Release Indicator"												AS [Milestone Auto Release Indicator],					
	"Grant Activity Milestone.Milestone Date Driven Indicator"												AS [Milestone Date Driven Indicator],
   	"Grant Activity Milestone.Milestone Overdue Status"														AS [Milestone Overdue Status],
    IF("Grant Activity Milestone.Milestone Days Overdue" < 31, 'Priority 3 - up to 30 days',
    IF("Grant Activity Milestone.Milestone Days Overdue" < 61, 'Priority 2 - 31-60 days',
    IF("Grant Activity Milestone.Milestone Days Overdue" < 91, 'Priority 1 - more than 60 days',
    IF("Grant Activity Milestone.Milestone Days Overdue" > 90, 'Priority 1 - more than 60 days')))) 		AS [Milestone Priority]

FROM [lib://AppData/PROD/AzureDataLake/GPS/Grant Activity Milestone.qvd]
(qvd);

LEFT JOIN
LOAD
    "Performance Report Assessment.Payment Milestone Id%"													AS [Activity Milestone Id%],
 	1																										AS [Payment on Performance Report]
FROM [lib://AppData/PROD/AzureDataLake/FUSION/Performance Report Assessment.qvd]
(qvd);

Concatenate LOAD

    "Grant Activity Missing Milestone.Milestone Id"															AS [Milestone Id],
    ''																										AS [Activity Milestone Id%],
    "Grant Activity Missing Milestone.Activity Id"															AS [Activity Id],
    "Grant Activity Missing Milestone.Milestone Expected Due Date"											AS [Milestone Expected Due Date],
    ''																										AS [Milestone Days Overdue],
    "Grant Activity Missing Milestone.Milestone Financial Year"												AS [Milestone Financial Year],
    "Grant Activity Missing Milestone.Milestone Status"														AS [Milestone Status],
    "Grant Activity Missing Milestone.Milestone Stage"														AS [Milestone Stage],
    "Grant Activity Missing Milestone.Milestone Received"													AS [Milestone Received],
    "Grant Activity Missing Milestone.Milestone Received Date"												AS [Milestone Received Date],
    "Grant Activity Missing Milestone.Milestone Completed Indicator"										AS [Milestone Completed],
    "Grant Activity Missing Milestone.Milestone Completion Date"											AS [Milestone Completion Date],
    "Grant Activity Missing Milestone.Milestone Payment Mode"												AS [Milestone Payment Mode],
    "Grant Activity Missing Milestone.Milestone Review Type"												AS [Milestone Review Type],
    "Grant Activity Missing Milestone.Milestone Type"														AS [Milestone Type],
    "Grant Activity Missing Milestone.Milestone Long Description"											AS [Milestone Long Description],
    "Grant Activity Missing Milestone.Milestone Short Description"											AS [Milestone Short Description],
    "Grant Activity Missing Milestone.Milestone Completion Description"										AS [Milestone Completion Description],
    "Grant Activity Missing Milestone.Milestone Action Required"											AS [Milestone Action Required],
    "Grant Activity Missing Milestone.Milestone Actual Amount Ex GST"										AS [Milestone Actual Amount Ex GST],
    "Grant Activity Missing Milestone.Milestone Auto Release Indicator"										AS [Milestone Auto Release Indicator],
    "Grant Activity Missing Milestone.Milestone Date Driven Indicator"										AS [Milestone Date Driven Indicator],
    "Grant Activity Missing Milestone.Milestone Overdue Status"												AS [Milestone Overdue Status],
    ''																										AS [Milestone Priority]
FROM [lib://AppData/PROD/AzureDataLake/GPS/Grant Activity Missing Milestone.qvd]
(qvd);



[Grant Activity Milestone]:
LEFT Keep ([Grant Activity])
LOAD  [Activity Milestone Id%],
      [Activity Id],
      [Milestone Id],
      IF(LEFT([Milestone Id],2) = 'AR' 
      OR LEFT([Milestone Id],2) = 'PR'
      OR LEFT([Milestone Id],3) = 'SVA',
      'Missing Id', [Milestone Id])																			AS [Milestone],
      IF([Milestone Review Type] = 'Acquittal', 'Acquittal Report',
      IF([Milestone Review Type] = 'Performance', 'Performance Report',
      IF([Milestone Review Type] = 'Site Visit', 'Site Visit Assessment',
      IF([Milestone Type] like '*Statement of Compliance*', 'Statement of Compliance',
      IF([Milestone Payment Mode] = 'Payment', 'Payment',
      'Other Report')))))																					AS [Milestone Category],
		[Milestone Type],
     IF([Milestone Payment Mode] = 'Payment' AND [Milestone Review Type] = 'Acquittal',
     'Acquittal',[Milestone Payment Mode]) 																	AS [Milestone Payment Mode],
      [Milestone Stage],
      [Milestone Received Date],
      [Milestone Completion Date],
      [Milestone Overdue Status],
      [Milestone Priority],
      [Milestone Completed],
      [Milestone Actual Amount Ex GST],
      [Milestone Expected Due Date],
      IF([Milestone Expected Due Date] <= Today() and [Milestone Stage] <> 'Completed', 
      	Today() - [Milestone Expected Due Date], 0) 														AS [Milestone Days Overdue],
      IF([Milestone Expected Due Date] > Today() and [Milestone Stage] <> 'Completed',
      	[Milestone Expected Due Date] - Today(), 0) 														AS [Milestone Days Until Due],
      IF([Milestone Stage] = 'Completed', 
      	Today() - [Milestone Completion Date], 0)															AS [Milestone Days Complete],
        [Milestone Completion Date] 
      	- [Milestone Expected Due Date]																		AS [Milestone Days to Complete],
      (Floor(([Milestone Completion Date] 
      	- [Milestone Expected Due Date])/30) * 30)+30 														AS [Milestone Days Complete Bins],
      [Milestone Financial Year],
      [Milestone Long Description],
      IF([Milestone Review Type] = 'Acquittal', 1, 0)														AS [Milestone Acquittal Review],
      IF([Milestone Review Type] = 'Performance', 1, 0)														AS [Milestone Performance Review],
      IF([Milestone Review Type] = 'Site Visit', 1, 0)														AS [Milestone Site Visit Assessment],
      IF(IsNull([Payment on Performance Report]), 
      			IF([Milestone Long Description] like '*Execution*', 'On Execution'
                			, 'Performance Report'),'Other')												AS [Milestone Payment Driver]					
Resident [Grant Activity Milestone Temp];




