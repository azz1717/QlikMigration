///$tab 09 - ILOC, IARE & IREG
//This connection is for 'GeoGetPolygonCenter' so I get the centroid
//LIB CONNECT TO 'GeoAnalytics Direct'; //connection not used in cloud. GeoGetPolygonCenter() supported natively in cloud. 

// [ILOC 2021]:
// LOAD
//     "ILOC 2021 Id" as [ILOC ID],
//     num#("ILOC Code 2021") as [ILOC Code],
//     "ILOC Name 2021" as [ILOC Name],
//     //"ILOC 2021.Indigenous Area Code" as [IAREA Code], //not found in curated data qvd
//     "ILOC Area SQKM 2021" as [ILOC Area Sq Km],
//     "ILOC Geometry 2021" as [ILOC Geometry],
//     GeoGetPolygonCenter("ILOC Geometry 2021") as [ILOC Center]
// FROM [lib://Curated Data Store - DEV:DataFiles/30 Curated Data Store/Geospatial Reporting/ASGS/Indigenous Location 2021.qvd]
// (qvd);




// [IARE]:
// LOAD

//     ('IARE'&"IARE Code 2021") AS [IARE_CODE_2021],
//     "IARE Name 2021" AS [IAREA Name],
//     //"IARE 2021.Indigenous Region Code" AS [IREGION Code], //not found in curated data qvd
//     "IARE Geometry 2021" as [IAREA Geometry]
// //     "IARE 2021 Id",
// //     "IARE Code 2021",
// //     "IARE Name 2021",
// //     "IARE Area SQKM 2021",
// //     "IARE Geometry 2021"
// FROM [lib://Curated Data Store - DEV:DataFiles/30 Curated Data Store/Geospatial Reporting/ASGS/Indigenous Area 2021.qvd]
// (qvd);



// [IREG]:
// LOAD
//     "IREG Code 2021" AS [IREGION Code],
//     "IREG Name 2021" AS [IREGION Name],
//     //"IREG 2021.Australian State" as [State Name], //not found in curated data qvd
//     "IREG Geometry 2021" as [IREGION Geometry]
// //     "IREG 2021 Id",
// //     "IREG Code 2021",
// //     "IREG Name 2021",
// //     "IREG Area SQKM 2021",
// //     "IREG Geometry 2021"
// FROM [lib://Curated Data Store - DEV:DataFiles/30 Curated Data Store/Geospatial Reporting/ASGS/Indigenous Region 2021.qvd]
// (qvd);



// [State 2016]:
// LOAD
// //     "STATE 2016.State Code",
//     "STATE 2016.State Name"as [State Name],
//     "STATE 2016.State/Territory" as [State Abbr],
//     "STATE 2016.Country" as [Country Name],
// //     "STATE 2016.Area Sq Km",
//     "STATE 2016.Geometry" as [State Geometry]
// FROM [lib://AppDataProd/Geospatial/STATE 2016.qvd]
// (qvd);

///$tab ABS ILOC Datapack
[2021 Census Datapacks x ILOC]:

LOAD
    num#("ILOC Id 2021") as [ILOC Code],
    "Total persons Aboriginal and or Torres Strait Islander Persons" as [ILOC_Tot_p_Indig_P],
    "Total persons Total Persons" as [ILOC_Tot_p_TotP]
FROM [lib://Curated Data Store - DEV:DataFiles/10 Landing Area/abs/Selected Person Characteristics by Indigenous Status by Sex.qvd]
(qvd);



// LOAD
//     text("ILOC Code") as [ILOC Code],
//     Tot_p_Indig_P as [ILOC_Tot_p_Indig_P],
//     Tot_p_TotP as [ILOC_Tot_p_TotP]
// FROM [lib://AppDataProd/AzureDataLake/ABS/2021 Census Datapacks x ILOC.qvd]
// (qvd);



///$tab Exit
Exit Script;


///$tab Grant Location
[Grant Activity Location]:
LEFT KEEP([Grant Activity])
LOAD
    "Grant Activity Location.Grant Activity Location Id%" AS [Grant Activity Location Id],
    "Grant Activity Location.Grant Activity Id%" AS [Grant Activity Id%],
//     "Grant Activity Location.Activity Location",
//     "Grant Activity Location.Location Type Code",
//     "Grant Activity Location.Location Type",
//     "Grant Activity Location.Electorate Id%",
//     "Grant Activity Location.Electorate",
//     "Grant Activity Location.Location Address Id%",
//     "Grant Activity Location.City/Suburb",
//     "Grant Activity Location.State",
//     "Grant Activity Location.Address Postcode",
//     "Grant Activity Location.SA1 Main Code",
//     "Grant Activity Location.ILOC Code",
//     "Grant Activity Location.ILOC Name",
//     "Grant Activity Location.Longitude",
//     "Grant Activity Location.Latitude",
	GeoMakePoint("Grant Activity Location.Latitude", "Grant Activity Location.Longitude") AS [Grant Activity Location],
//     "Grant Activity Location.Empowered Community Id%",
//     "Grant Activity Location.Empowered Community",
//     "Grant Activity Location.Location Start Date",
//     "Grant Activity Location.Location End Date",
//     "Grant Activity Location.Remoteness Area",
//     "Grant Activity Location.Source System Status Id%",
//     "Grant Activity Location.Source System Status",
//     "Grant Activity Location.Source Location Type Id%",
//     "Grant Activity Location.Source Location Type",
//     "Grant Activity Location.Estimated Location Attribution",
//     "Grant Activity Location.Activity Location Status",
//     "Grant Activity Location.Location Id",
//     "Grant Activity Location.Mesh Block Code 2016",
    "Grant Activity Location.Mesh Block Code 2021" as [MB Code]

LOAD
    "Grant Activity Location Id",
    "Grant Activity Id",
    "Activity Location",
    "Location Type Code",
    "Location Type",
    "Electorate Id",
    Electorate,
    "Location Address Id",
    "City/Suburb",
    State,
    "Address Postcode",
    "SA1 Main Code",
    "ILOC Code",
    "ILOC Name",
    Longitude,
    Latitude,
    "Mesh Block Code 2016",
    "Mesh Block Code 2021",
    "Empowered Community Id",
    "Empowered Community",
    "Location Start Date",
    "Location End Date",
    "Remoteness Area",
    "Source System Status Id",
    "Source System Status",
    "Source Location Type Id",
    "Source Location Type",
    "Estimated Location Attribution",
    "Activity Location Status",
    "Location Id"
FROM [lib://Data Preparation - DEV:DataFiles/10 Landing Area/FUSION/Grant Activity Location.qvd]
(qvd);





[Grant Activity Location Attribution]:
LEFT KEEP([Grant Activity Location])
LOAD
	[Grant Activity Location Attribution.Grant Activity Location Attribution Id%],
// 	[Grant Activity Location Attribution.Financial Year Id%]AS [Financial Year Id%],
	[Grant Activity Location Attribution.Financial Year] as [Location Attribution Fin Year],
	[Grant Activity Location Attribution.Attribution] as [Location Attribution],
	[Grant Activity Location Attribution.Grant Activity Location Id%] AS [Grant Activity Location Id],
	[Grant Activity Location Attribution.Status] as [Location Attribution Status]
 FROM [lib://AppData/PROD\AzureDataLake\FUSION\Grant Activity Location Attribution.qvd]
(qvd)
//Why are there $0 attributions?
// where [Grant Activity Location Attribution.Attribution] > 0
;




///$tab 10 - ABS data by Region
LIB CONNECT TO 'AzureDbProdNIAADL';


// [ABS Data x Reg 2011-2021 Temp]:
[ABS Data x Reg 2011-2021]:

LEFT KEEP ([ILOC 2021])
LOAD text(Code) as [IAREA Code], 
	Label as [Data x Reg Label], 
	Year as [Data x Reg Year], 
// 	ERP_Median_age_males_yr, 
// 	ERP_Median_age_females_yr, 
// 	ERP_Median_age_persons_yr, 
