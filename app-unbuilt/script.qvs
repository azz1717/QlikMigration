    "Indigenous Land Use Agreement.Zone EEZ Indicator" as [ILUA Zone EEZ Indicator],
    "Indigenous Land Use Agreement.NNTT Sequence No" as [ILUA NNTT Sequence No],
    "Indigenous Land Use Agreement.Spatial Note" as [ILUA Spatial Note],
    "Indigenous Land Use Agreement.GeoTrack Ref" as [ILUA GeoTrack Ref],
    "Indigenous Land Use Agreement.s78 Id" as [ILUA S78 Id],
    "Indigenous Land Use Agreement.Date Assistance" as [ILUA Date Assistance],
    "Indigenous Land Use Agreement.State Jurisdiction" as [ILUA State Jurisdiction],
