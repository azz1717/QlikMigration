///$tab Grant Organisation
[Organisation]:
LOAD
    "Organisation.Organisation Id%" AS [Organisation Id%],
    Replace(Replace(Replace(Capitalize(Organisation.Organisation),'Incorporated','Inc'),'Limited','Ltd'),'Proprietary','Pty')
     as [Organisation Name],
//     "Organisation.Entity Type Code",
//     "Organisation.Entity Type",
//     Organisation.ABN as [ABN],
//     "Organisation.ASIC Number",
//     "Organisation.Email Address",
//     Organisation.City,
//     Organisation.State,
//     Organisation.Postcode,
    "Organisation.ORP Approved Date" as [ORP Approved Date],
    "Organisation.ORP Expiry Date" as [ORP Expiry Date],
    "Organisation.ORP Risk Rating" as [ORP Risk Rating],
    "Organisation.Risk Exemption Date" as [Risk Exemption Date],
    "Organisation.Risk Exemption Justification" as [Risk Exemption Justification],
    "Organisation.Risk Exemption Reason" as [Risk Exemption Reason],
    "Organisation.Indigenous Status" as [Organisation Indigenous Status],
    Organisation.Indigeneity as [Organisation Indigeneity],
//     "Organisation.Indigeneity Effective Date",
//     Organisation.Status,
    "Organisation.Latest Performance Rating" as [Organisation Latest Performance Rating],
//     "Organisation.PRA Approved Date",
    "Organisation.Compliance Concern" as [Organisation Compliance Concern],
    "Organisation.Compliance Concern Updated On" as [Organisation Compliance Concern Updated On],
    "Organisation.Compliance Concern Updated By" as [Organisation Compliance Concern Updated By],
//     Organisation.Latitude,
//     Organisation.Longitude
	GeoMakePoint("Organisation.Latitude", "Organisation.Longitude") AS [Organisation Location]
FROM [lib://AppDataProd/AzureDataLake/FUSION/Organisation.qvd]
(qvd);


[Grant Activity Contact]:
LOAD
    "Grant Activity Contact.Contact Id" as [Contact Id],
    "Grant Activity Contact.Activity Id" AS [Activity Id],
    "Grant Activity Contact.Contact Title" as [Contact Title],
    "Grant Activity Contact.Contact First Name" as [Contact First Name],
    "Grant Activity Contact.Contact Last Name" as [Contact Last Name],
    "Grant Activity Contact.Contact Email" as [Contact Email],
    "Grant Activity Contact.Contact Phone Number" as [Contact Phone]
