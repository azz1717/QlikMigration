// 	UA_Provided_unpaid_assistance_Perc, 
	UCC_Cared_for_own_children, 
// 	UCC_Cared_for_own_children_Perc, 
	UCC_Cared_for_other_children, 
// 	UCC_Cared_for_othern_children_Perc, 
	UCC_Total_provided_unpaid_child_care, 
// 	UCC_Total_provided_unpaid_child_care_Perc, 
	UCC_Did_not_provide_unpaid_child_care, 
// 	UCC_Did_not_provide_unpaid_child_care_Perc, 
	VW_Volunteered_for_an_organisation_or_group, 
// 	VW_Volunteered_for_an_organisation_or_group_Perc, 
	TT_Owner_with_or_without_a_mortgage, 
// 	TT_Owner_with_or_without_a_mortgage_Perc, 
	TT_Renter, 
// 	TT_Renter_Perc, 
