[Grant Activity Performance Item]:
LEFT KEEP ([Grant Activity])
LOAD
    "Grant Activity Performance Item.Activity Id" 						AS [Activity Id],
    "Grant Activity Performance Item.Review Id"							AS [Performance Review Id],
    "Grant Activity Performance Item.Review Id" & "Grant Activity Performance Item.Review Item Answer"	AS [Grant Activity KPI Assessment Key%],
//    "Grant Activity Performance Item.Review Title",
//    "Grant Activity Performance Item.Review Item Id",
    "Grant Activity Performance Item.Activity Performance Indicator Id" as [Activity Performance Indicator Id], 
    "Grant Activity Performance Item.Review Item Number",//				AS [Grant Activity Performance Item Review Item Number],
