///$tab SA2

///$tab Staff for Matrix
[Organisation Staff]:
LOAD
 "Organisation Staff.Aurion Id" as [Aurion Id],
//     "Organisation Staff.Group",
    if("Organisation Staff.Division"='Central','Central Group',if("Organisation Staff.Division"='Eastern','Eastern Group',if("Organisation Staff.Division"='West and South Group','West South Group',"Organisation Staff.Division"))) as [NIAA Staff Group Name],
    if("Organisation Staff.Branch" = 'Western NSW','Western New South Wales', if("Organisation Staff.Branch" = 'Arnhem Land and Groote Eylandt','Arnhem Land & Groote Eylandt',if("Organisation Staff.Branch" = 'Central Australia','Central',if("Organisation Staff.Branch" = 'Eastern NSW','Eastern New South Wales',if("Organisation Staff.Branch" = 'Greater WA','Greater Western Australia',if("Organisation Staff.Branch" = 'North Queensland Region','North Queensland',if("Organisation Staff.Branch" = 'South QLD','South Queensland',if("Organisation Staff.Branch" = 'Top End and Tiwi Islands','Top End & Tiwi Islands',if("Organisation Staff.Branch" = 'Victoria - Tasmania','Victoria & Tasmania',"Organisation Staff.Branch"))))))))) as [OrgStaff Region Name],
    "Organisation Staff.Section" as [Section],
    "Organisation Staff.Subsection" as [Subsection],
//     "Organisation Staff.Org Costing" as [Org Costing],
    "Organisation Staff.Posn No" as [Position No.],
    "Organisation Staff.Posn No" as [OCPosition No.],
    "Organisation Staff.Current Position Title" as [Position Title],
    "Organisation Staff.Class Desc" as [Class Desc],
//     ApplyMap('Map_ClassOrder',"Organisation Staff.Class Desc",Null()) as [Class Order],
    if(IsNull(EmptyIsNull("Organisation Staff.Actual Occupant")), 'No','Yes') as [Position Occupied],
    if(IsNull(EmptyIsNull("Organisation Staff.Substantive Occupant")), 'No','Yes') as [Position Owned],  
//     if("Organisation Staff.Current Position Title"='Government Engagement Coordinator', 'Yes','No') as [GEC],
//     If(match("Organisation Staff.Current Position Title",'Government Engagement Coordinator','Indiegnous Engagement Officer'),'Yes','No') as [GEC/IEO],
    "Organisation Staff.Actual Occupant" as [Actual Occupant],
//     "Organisation Staff.Employment Type" as [Employment Type],
    num#("Organisation Staff.FTE") as FTE
//     "Organisation Staff.Location Code" as [Aurion Location Code],
//     "Organisation Staff.GMU Region Id%",
//     "Organisation Staff.Location Short Description",
//     "Organisation Staff.Substantive Occupant" as [Substantive Occupant],
//     "Organisation Staff.Reports to Employee",
//     "Organisation Staff.Reports to Position" as [Reports to Position]
FROM [lib://AppDataProd/AzureDataLake/AURION/Organisation Staff.qvd]
(qvd)
where match ("Organisation Staff.Division", 'Central','Eastern', 'West and South Group')
;



///$tab Section 2
LOAD
    Id,
    CED_CODE,
    CED_NAME,
    AREASQKM,
    Polygon
FROM [lib://Curated Data Store - DEV:DataFiles/10 Landing Area/abs/CED.qvd]
(qvd);

