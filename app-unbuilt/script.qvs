//     "Site Visit Location.Address City/Suburb",
    "Site Visit Location.Address State/Territory" 									as [Site Visit Location State/Territory],
//     "Site Visit Location.Address Postal Code",
//     "Site Visit Location.Address Latitude"											AS [Site Visit Latitude],
//     "Site Visit Location.Address Longitude"											AS [Site Visit Longitude],
    GeoMakePoint("Site Visit Location.Address Latitude", "Site Visit Location.Address Longitude") AS [Site Visit Location]
//     "Site Visit Location.SA1 Main Code",
