///$tab 98-Community Categories
//Variables

//ILOC Sq Kms
set vILOCSqKmL = '50';
set vILOCSqKmH = '250';

//ILOC Indigenous Prportion
set vILOCIndPropL = '0.095';
set vILOCIndPropH = '0.2';

//ILOC Indigenous Population
set vILOCIndPopL = '200';
set vILOCIndPopM = '500';
set vILOCIndPopH = '1000';
set vILOCIndPopVH = '1500';


[Temp Community Category]:

LOAD
    [ILOC Code],
// 	[ILOC Area Sq Km],
    if([ILOC Area Sq Km]<=$(vILOCSqKmL),'Concentrated',
    	if([ILOC Area Sq Km]>$(vILOCSqKmL) and [ILOC Area Sq Km]<=$(vILOCSqKmH),'Moderate',
        	if([ILOC Area Sq Km]>$(vILOCSqKmH),'Dispersed'))) as [Area Category]
resident [ILOC 2021]
;

left join 
LOAD 
	[ILOC Code], 
// 	Tot_p_Indig_P,
	if([Tot_p_Indig_P]/[Tot_p_TotP]>=$(vILOCIndPropH), 'High',
    	if([Tot_p_Indig_P]/[Tot_p_TotP]>=$(vILOCIndPropL), 'Low'
        ,'<9.5%'))  as [Population% Check],
    if(Tot_p_Indig_P>$(vILOCIndPopVH), 'Very Large',
    	if(Tot_p_Indig_P>$(vILOCIndPopH), 'Large',
    		if(Tot_p_Indig_P<=$(vILOCIndPopH) and Tot_p_Indig_P>$(vILOCIndPopM), 'Moderate',
        		if(Tot_p_Indig_P<=$(vILOCIndPopM) and Tot_p_Indig_P>$(vILOCIndPopL), 'Small',
            		if(Tot_p_Indig_P<=$(vILOCIndPopL),'Very Small'))))) as [Population# Category]    
resident [2021 Census Datapacks x ILOC]
;

//Define our regional HQs - should be done at source in Aurion... one day
// [RegionHQs]:
Left Join
Load * Inline [
ILOC Code,ILOC Name,NIAA Office in ILOC,Regional HQ
40100101,Adelaide - Central,Adelaide,Yes
30100202,Brisbane City - Inner North,Brisbane,Yes
50100102,Broome - North,Broome,Yes
30900202,Cairns - City,Cairns,Yes
70800101,Charles,Alice Springs,Yes
70300501,Darwin - Central,Darwin,Yes
10100201,Dubbo - East,Dubbo,Yes
20101201,Melbourne - Central,Melbourne,Yes
80100201,Narrabundah - Weston,Charles Perkins House,Yes
70600502,Nhulunbuy,Nhulunbuy,Yes
10702101,Parramatta - Central,Parramatta,Yes
50501401,Perth - Central,Perth,Yes
];



[Community Category]:
Load
[ILOC Code],
// [ILOC Name] as [Hub ILOC Name],
[Area Category],
[Population% Check],
[Population# Category],
// [NIAA Office in ILOC],
[Regional HQ],

(if([Regional HQ]='Yes', 'NIAA Region HQ',

if([Population% Check]='High' and match([Population# Category],'Large','Very Large') and match([Area Category],'Concentrated','Moderate'), 'Hub',
if([Population% Check]='High' and match([Population# Category],'Large','Very Large') and match([Area Category],'Dispersed'), 'Spoke',

if([Population% Check]='High' and match([Population# Category],'Moderate') and match([Area Category],'Concentrated'), 'Hub',
if([Population% Check]='High' and match([Population# Category],'Moderate') and match([Area Category],'Moderate'), 'Spoke',
if([Population% Check]='High' and match([Population# Category],'Moderate') and match([Area Category],'Dispersed'), 'Fixed Term Community Officer',

if([Population% Check]='High' and match([Population# Category],'Small') and match([Area Category],'Concentrated'), 'Spoke',
if([Population% Check]='High' and match([Population# Category],'Small') and match([Area Category],'Moderate'), 'Spoke or Fixed Term',
if([Population% Check]='High' and match([Population# Category],'Small') and match([Area Category],'Dispersed'), 'Fixed Term Community Officer',

if([Population% Check]='High' and match([Population# Category],'Very Small') and match([Area Category],'Concentrated'), 'Spoke or Fixed Term',
if([Population% Check]='High' and match([Population# Category],'Very Small') and match([Area Category],'Moderate'), 'Fixed Term Community Officer',
if([Population% Check]='High' and match([Population# Category],'Very Small') and match([Area Category],'Dispersed'), 'Fixed Term Community Officer',

if([Population% Check]='Low' and match([Population# Category],'Very Large') and match([Area Category],'Concentrated','Moderate'), 'Regional Hub',
'Conditions not met'
)))))))))))))) as [Service Category],

(if([Regional HQ]='Yes', 'NIAA Region HQ',

if([Population% Check]='High' and match([Population# Category],'Large','Very Large') and match([Area Category],'Concentrated','Moderate'), 'Tier 1',
if([Population% Check]='High' and match([Population# Category],'Large','Very Large') and match([Area Category],'Dispersed'), 'Tier 2',

if([Population% Check]='High' and match([Population# Category],'Moderate') and match([Area Category],'Concentrated'), 'Tier 1',
if([Population% Check]='High' and match([Population# Category],'Moderate') and match([Area Category],'Moderate'), 'Tier 2',
if([Population% Check]='High' and match([Population# Category],'Moderate') and match([Area Category],'Dispersed'), 'Tier 3',

if([Population% Check]='High' and match([Population# Category],'Small') and match([Area Category],'Concentrated'), 'Tier 2',
if([Population% Check]='High' and match([Population# Category],'Small') and match([Area Category],'Moderate'), 'Tier 2',
if([Population% Check]='High' and match([Population# Category],'Small') and match([Area Category],'Dispersed'), 'Tier 3',

if([Population% Check]='High' and match([Population# Category],'Very Small') and match([Area Category],'Concentrated'), 'Tier 2',
if([Population% Check]='High' and match([Population# Category],'Very Small') and match([Area Category],'Moderate'), 'Tier 3',
if([Population% Check]='High' and match([Population# Category],'Very Small') and match([Area Category],'Dispersed'), 'Tier 3',

if([Population% Check]='Low' and match([Population# Category],'Very Large') and match([Area Category],'Concentrated','Moderate'), 'Tier 1',


'Conditions not met'
)))))))))))))) as [New Service Category]
Resident [Temp Community Category]
;

drop table [Temp Community Category];




















///$tab 99-Hub and Spoke
//Note to self - change the variables to actual variables and put em up top


