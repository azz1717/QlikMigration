///$tab ORIC
[ORIC Corporations]:
LOAD
    "ORIC ID",
    ICN,
    "ORIC Corporation",
    "ORIC Incorporation Date",
    "ORIC Status",
    "ORIC Status Date",
    "ORIC Size",
    ABN,
    "ORIC State",
    "ORIC Post Code",
    "ORIC Locality",
    "ORIC Industry",
    "ORIC ACNC Registered?",
    "ORIC Number of Members",
    "ORIC Number of Directors",
    "ORIC Total Income 2019/20",
    "ORIC Total Assets 2019/20",
    "ORIC Number of Employees 2019/20",
    "ORIC Total Income 2020/21",
    "ORIC Total Assets 2020/21",
    "ORIC Number of Employees 2020/21",
    "ORIC Total Income 2021/22",
    "ORIC Total Assets 2021/22",
    "ORIC Number of Employees 2021/22",
    "ORIC URL"
FROM [lib://AppDataProd/AzureDataLake/ORIC/ORIC Corporations.qvd]
(qvd);










