    UA_Provided_unpaid_assistance/(UA_Provided_unpaid_assistance_Perc/100) as [UA_Denominator],
//     UCC_Did_not_provide_unpaid_child_care/(UCC_Did_not_provide_unpaid_child_care_Perc/100) as [UCC_Denominator],
    UCC_Total_provided_unpaid_child_care+UCC_Did_not_provide_unpaid_child_care as [UCC_Denominator],
    VW_Volunteered_for_an_organisation_or_group/(VW_Volunteered_for_an_organisation_or_group_Perc/100) as [VW_Denominator],
