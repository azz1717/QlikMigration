///$tab 03 - Closest Office to Office
//need to redo the closest so I dont need this temp table here


Offices:
LOAD
    [Office Name] AS Office,
    [NIAA Site Location] AS Location
Resident [NIAA Office Locations]
;


// LIB CONNECT TO 'Rods_GeoServerTest (azure_rod.stewart@niaa.gov.au)';
LIB CONNECT TO 'GeoAnalytics Direct';


/* Generated by GeoAnalytics for operation Closest ---------------------- */
[_inlineMap_]:
mapping LOAD * inline [
_char_, _utf_
"'", '\u0027'
'"', '\u0022'
"[", '\u005b'
"/", '\u002f'
"*", '\u002a'
";", '\u003b'
"}", '\u007d'
"{", '\u007b'
"`", '\u0060'
"´", '\u00b4'
"	", '\u0009'
];

IF FieldNumber('Office', 'Offices') = 0 THEN
	call InvalidInlineData('The field Office in Offices is not available');
END IF
IF FieldNumber('Location', 'Offices') = 0 THEN
	call InvalidInlineData('The field Location in Offices is not available');
END IF
[Offices_Distinct_Temp]:
LOAD distinct [Office] AS tmpField_0, [Location] AS tmpField_1 resident Offices;

Let [OfficeFromInlineTable] = 'Office' & Chr(9) & 'Location';
Let numRows = NoOfRows('Offices_Distinct_Temp');
Let chunkSize = 1000;
Let chunks = numRows/chunkSize;
For n = 0 to chunks
	Let chunkText = '';
	Let chunk = n*chunkSize;
	For i = 0 To chunkSize-1
		Let row = '';
		Let rowNr = chunk+i;
		Exit for when rowNr >= numRows;
		For Each f In 'tmpField_0', 'tmpField_1'
			row = row & Chr(9) & MapSubString('_inlineMap_', Peek('$(f)', $(rowNr), 'Offices_Distinct_Temp'));
		Next
		chunkText = chunkText & Chr(10) & Mid('$(row)', 2);
	Next
	[OfficeFromInlineTable] = [OfficeFromInlineTable] & chunkText;
Next
chunkText=''

DROP tables [Offices_Distinct_Temp];

[_inlineMap_]:
mapping LOAD * inline [
_char_, _utf_
"'", '\u0027'
'"', '\u0022'
"[", '\u005b'
"/", '\u002f'
"*", '\u002a'
";", '\u003b'
"}", '\u007d'
"{", '\u007b'
"`", '\u0060'
"´", '\u00b4'
"	", '\u0009'
];

IF FieldNumber('Office', 'Offices') = 0 THEN
	call InvalidInlineData('The field Office in Offices is not available');
END IF

IF FieldNumber('Location', 'Offices') = 0 THEN
	call InvalidInlineData('The field Location in Offices is not available');
END IF

Let [OfficeToInlineTable] = 'Office' & Chr(9) & 'Location';
Let numRows = NoOfRows('Offices');
Let chunkSize = 1000;
Let chunks = numRows/chunkSize;
For n = 0 to chunks
	Let chunkText = '';
	Let chunk = n*chunkSize;
	For i = 0 To chunkSize-1
		Let row = '';
		Let rowNr = chunk+i;
		Exit for when rowNr >= numRows;
		For Each f In 'Office', 'Location'
			row = row & Chr(9) & MapSubString('_inlineMap_', Peek('$(f)', $(rowNr), 'Offices'));
		Next
		chunkText = chunkText & Chr(10) & Mid('$(row)', 2);
	Next
	[OfficeToInlineTable] = [OfficeToInlineTable] & chunkText;
Next
chunkText=''


[ClosestAssociations]:
SQL SELECT [OfficeFrom_OfficeTo_RelationId], 
[OfficeFrom.Office], 
[OfficeTo.Office], 
[OfficeFrom_OfficeTo_Distance], 
[OfficeFrom_OfficeTo_Route] 
FROM Closest(costUnit='Kilometers', distance='1000', distanceType='car', closestCount='1', dataset1='OfficeFrom', dataset2='OfficeTo')
DATASOURCE OfficeFrom INLINE tableName='Offices', tableFields='Office,Location', geometryType='POINT', loadDistinct='YES', suffix='', crs='Auto' {$(OfficeFromInlineTable)}
DATASOURCE OfficeTo INLINE tableName='Offices', tableFields='Office,Location', geometryType='POINT', loadDistinct='NO', suffix='', crs='Auto' {$(OfficeToInlineTable)}
;
tag field [OfficeFrom_OfficeTo_RelationId] with '$primarykey';
tag field [OfficeFrom_OfficeTo_Route] with '$geoline';
tag field [OfficeFrom_OfficeTo_RelationId] with '$geoname';
tag field [OfficeFrom_OfficeTo_Route] with '$relates_OfficeFrom_OfficeTo_RelationId';
tag field [OfficeFrom_OfficeTo_RelationId] with '$relates_OfficeFrom_OfficeTo_Route';

[OfficeFromInlineTable] = '';
[OfficeToInlineTable] = '';

/* End GeoAnalytics operation Closest ----------------------------------- */



[Nearest Offices]:
LOAD
    OfficeFrom_OfficeTo_RelationId,
    OfficeFrom.Office as "Office Name",
    OfficeTo.Office as [Nearest Office],
    OfficeFrom_OfficeTo_Distance as [Drive Distance],
    if(OfficeFrom_OfficeTo_Distance <= 100, 'Yes', 'No') as [Too Close],
    OfficeFrom_OfficeTo_Route as [Nearest Route]
Resident ClosestAssociations;

// Tie it up with the nearest office locations so we can display them easily on the map as a separate layer
Left Join
Load 
	[Office Name] as [Nearest Office],
    [NIAA Site Location] as [Nearest Site Location]
resident [NIAA Office Locations];


// cleanup the no longer needed tables
Drop Tables ClosestAssociations;


///$tab 04 - 250km Drive Range
/*********************************************************************************************************************************************
					Calculate 250Km Drive Areas for offices


*********************************************************************************************************************************************/


LIB CONNECT TO 'GeoAnalytics Direct';


/* Generated by GeoAnalytics for operation TravelAreas ---------------------- */
[_inlineMap_]:
mapping LOAD * inline [
_char_, _utf_
"'", '\u0027'
'"', '\u0022'
"[", '\u005b'
"/", '\u002f'
"*", '\u002a'
";", '\u003b'
"}", '\u007d'
"{", '\u007b'
"`", '\u0060'
"´", '\u00b4'
"	", '\u0009'
];

IF FieldNumber('Office', 'Offices') = 0 THEN
	call InvalidInlineData('The field Office in Offices is not available');
END IF
IF FieldNumber('Location', 'Offices') = 0 THEN
	call InvalidInlineData('The field Location in Offices is not available');
END IF
[Offices_Distinct_Temp]:
LOAD distinct [Office] AS tmpField_0, [Location] AS tmpField_1 resident Offices;

Let [DatasetInlineTable] = 'Office' & Chr(9) & 'Location';
Let numRows = NoOfRows('Offices_Distinct_Temp');
Let chunkSize = 1000;
Let chunks = numRows/chunkSize;
For n = 0 to chunks
	Let chunkText = '';
	Let chunk = n*chunkSize;
	For i = 0 To chunkSize-1
		Let row = '';
		Let rowNr = chunk+i;
		Exit for when rowNr >= numRows;
		For Each f In 'tmpField_0', 'tmpField_1'
			row = row & Chr(9) & MapSubString('_inlineMap_', Peek('$(f)', $(rowNr), 'Offices_Distinct_Temp'));
		Next
		chunkText = chunkText & Chr(10) & Mid('$(row)', 2);
	Next
	[DatasetInlineTable] = [DatasetInlineTable] & chunkText;
Next
chunkText=''

DROP tables [Offices_Distinct_Temp];

[TravelAreas]:
SQL SELECT [Office], [Dataset_TravelArea], [Dataset_Origin], [Dataset_Cost], [Dataset_CostUnit], [Dataset_Status] FROM TravelAreas(costValue='250', costField='', costUnit='Kilometers', transportation='car', dataset='Dataset')
DATASOURCE Dataset INLINE tableName='Offices', tableFields='Office,Location', geometryType='POINT', loadDistinct='YES', suffix='', crs='Auto' {$(DatasetInlineTable)}
;
tag field [Office] with '$primarykey';
tag field [Dataset_TravelArea] with '$geopolygon';
tag field [Office] with '$geoname';
tag field [Dataset_TravelArea] with '$relates_Office';
tag field [Office] with '$relates_Dataset_TravelArea';

[DatasetInlineTable] = '';

/* End GeoAnalytics operation TravelAreas ----------------------------------- */


//This joins the results back to the o.g. office locations table
left Join([NIAA Office Locations])
LOAD
    Office as [Office Name],
    Dataset_TravelArea as [250km Drive Area]
Resident TravelAreas;


// cleanup the no longer needed tables
Drop Tables Offices,TravelAreas;

///$tab 06 - Closest Office to AGIL
LIB CONNECT TO 'GeoAnalytics Direct';

/* Generated by GeoAnalytics for operation Closest ---------------------- */
[_inlineMap_]:
mapping LOAD * inline [
_char_, _utf_
"'", '\u0027'
'"', '\u0022'
"[", '\u005b'
"/", '\u002f'
"*", '\u002a'
";", '\u003b'
"}", '\u007d'
"{", '\u007b'
"`", '\u0060'
"´", '\u00b4'
"	", '\u0009'
];

IF FieldNumber('AGIL Code', 'AGIL') = 0 THEN
	call InvalidInlineData('The field AGIL Code in AGIL is not available');
END IF
IF FieldNumber('AGIL Location', 'AGIL') = 0 THEN
	call InvalidInlineData('The field AGIL Location in AGIL is not available');
END IF
Let [CommunityInlineTable] = 'AGIL Code' & Chr(9) & 'AGIL Location';
Let numRows = NoOfRows('AGIL');
Let chunkSize = 1000;
Let chunks = numRows/chunkSize;
For n = 0 to chunks
	Let chunkText = '';
	Let chunk = n*chunkSize;
	For i = 0 To chunkSize-1
		Let row = '';
		Let rowNr = chunk+i;
		Exit for when rowNr >= numRows;
		For Each f In 'AGIL Code', 'AGIL Location'
			row = row & Chr(9) & MapSubString('_inlineMap_', Peek('$(f)', $(rowNr), 'AGIL'));
		Next
		chunkText = chunkText & Chr(10) & Mid('$(row)', 2);
	Next
	[CommunityInlineTable] = [CommunityInlineTable] & chunkText;
Next
chunkText=''
[_inlineMap_]:
mapping LOAD * inline [
_char_, _utf_
"'", '\u0027'
'"', '\u0022'
"[", '\u005b'
"/", '\u002f'
"*", '\u002a'
";", '\u003b'
"}", '\u007d'
"{", '\u007b'
"`", '\u0060'
"´", '\u00b4'
"	", '\u0009'
];

IF FieldNumber('Aurion Location Code', 'NIAA Office Locations') = 0 THEN
	call InvalidInlineData('The field Aurion Location Code in NIAA Office Locations is not available');
END IF
IF FieldNumber('NIAA Site Location', 'NIAA Office Locations') = 0 THEN
	call InvalidInlineData('The field NIAA Site Location in NIAA Office Locations is not available');
END IF
Let [NIAAInlineTable] = 'Aurion Location Code' & Chr(9) & 'NIAA Site Location';
Let numRows = NoOfRows('NIAA Office Locations');
Let chunkSize = 1000;
Let chunks = numRows/chunkSize;
For n = 0 to chunks
	Let chunkText = '';
	Let chunk = n*chunkSize;
	For i = 0 To chunkSize-1
		Let row = '';
		Let rowNr = chunk+i;
		Exit for when rowNr >= numRows;
		For Each f In 'Aurion Location Code', 'NIAA Site Location'
			row = row & Chr(9) & MapSubString('_inlineMap_', Peek('$(f)', $(rowNr), 'NIAA Office Locations'));
		Next
		chunkText = chunkText & Chr(10) & Mid('$(row)', 2);
	Next
	[NIAAInlineTable] = [NIAAInlineTable] & chunkText;
Next
chunkText=''


[ClosestAssociations]:
SQL SELECT [Community_NIAA_RelationId], [AGIL Code], [Aurion Location Code], [Community_NIAA_Distance], [Community_NIAA_Route] FROM Closest(costUnit='Kilometers', distance='1000', distanceType='car', closestCount='1', dataset1='Community', dataset2='NIAA')
DATASOURCE Community INLINE tableName='AGIL', tableFields='AGIL Code,AGIL Location', geometryType='POINT', loadDistinct='NO', suffix='', crs='Auto' {$(CommunityInlineTable)}
DATASOURCE NIAA INLINE tableName='NIAA Office Locations', tableFields='Aurion Location Code,NIAA Site Location', geometryType='POINT', loadDistinct='NO', suffix='', crs='Auto' {$(NIAAInlineTable)}
;
tag field [Community_NIAA_RelationId] with '$primarykey';
tag field [Community_NIAA_Route] with '$geoline';
tag field [Community_NIAA_RelationId] with '$geoname';
tag field [Community_NIAA_Route] with '$relates_Community_NIAA_RelationId';
tag field [Community_NIAA_RelationId] with '$relates_Community_NIAA_Route';

[CommunityInlineTable] = '';
[NIAAInlineTable] = '';

/* End GeoAnalytics operation Closest ----------------------------------- */





left join load 
[Aurion Location Code],
[Office Name],
[NIAA Site Location]
resident [NIAA Office Locations];

[Closest Office to AGIL]:
noconcatenate load
autonumber([AGIL Code]) as [Closest Office Id],
[AGIL Code],
[Aurion Location Code] as [Closest Aurion Location Code],
[Office Name] as [Closest Office Name],
[NIAA Site Location] as [Closest Office to AGIL Location],
[Community_NIAA_Distance] as [Closest Office Distance Kms],
[Community_NIAA_Route] as [Closest Route AGIL to Office]
resident [ClosestAssociations];

drop table [ClosestAssociations];

///$tab 07 - Staff
[IAM Staff]:
LOAD
    "IAM User Id" as [IAM User Id],
    "Aurion Id" as [Aurion Id],
    Title as [IAM Title],
    "Preferred Name" as [IAM Preferred Name],
    "Given Names" as [IAM Given Names],
    Surname as [IAM Surname],
    "Search Name" as [IAM Search Name],
    Classification as [IAM Classification],
    "Desk Phone" as [IAM Desk Phone],
    "Work Mobile" as [IAM Work Mobile],
    "Email Address" as [IAM Email Address],
    Division as [IAM Division],
    "Section" as [IAM Section],
    Team as [IAM Team],
    Branch as [IAM Branch],
    State as [IAM State],
    "Position State" as [NIAA Office Code],
    "Supervisor Id" as [IAM Supervisor Id],
    "Supervisor Aurion Id" as [IAM Supervisor Aurion Id],
    Supervisor as [IAM Supervisor]
FROM [lib://AppDataProd/AzureDataLake/IAM/NIAA Staff.QVD]
(qvd);






[temp Organisation Staff]:
LOAD
    "Organisation Staff.Group" as [Aurion Group],
    "Organisation Staff.Division" as [Aurion Division],
    "Organisation Staff.Branch" as [Aurion Branch],
    "Organisation Staff.Section" as [Aurion Section],
    "Organisation Staff.Subsection" as [Aurion Subsection],
    "Organisation Staff.Posn No" as [Aurion Position Number],
    "Organisation Staff.Current Position Title" as [Aurion Position Title],
    "Organisation Staff.Class Desc" as [Aurion Class Description],
    If(match("Organisation Staff.Class Desc",'SESB1','SESB2','SESB3','Statutory'),'SES',
      If(match("Organisation Staff.Class Desc",'EL2'),'EL2',
          If(match("Organisation Staff.Class Desc",'EL1'),'EL1',
              If(match("Organisation Staff.Class Desc",'APS1','APS2','APS3','APS4','APS5','APS6'),'APS',
                  If(match("Organisation Staff.Class Desc",'Board'),'Board',
                      'Other'))))) as [Aurion Class Group],
    "Organisation Staff.Actual Occupant" as [Aurion Actual Occupant],
    "Organisation Staff.Employment Type" as [Aurion Employment Type],
    "Organisation Staff.FTE" as [Aurion FTE],
    "Organisation Staff.Location Code" as [Aurion Location Code],
    "Organisation Staff.Substantive Occupant" as [Aurion Substantive Occupant],
    "Organisation Staff.Reports to Employee" as [Aurion Reports to Employee],
    "Organisation Staff.Reports to Position" as [Aurion Reports to Position],
    "Organisation Staff.Aurion Id" as [Aurion Id],
    "Organisation Staff.Attendance Type" as [Aurion Attendance Type],
    "Organisation Staff.Employee Number" as [Aurion Employee Number],
    "Organisation Staff.Organisation Unit Name" as [Aurion Organisation Unit Name],
    "Organisation Staff.Position Occupied" as [Aurion Position Occupied],
    "Organisation Staff.Employee Status" as [Aurion Employee Status],
    "Organisation Staff.Currently on Leave" as [Aurion Currently on Leave],
    "Organisation Staff.Return Date" as [Aurion Staff Return Date],
//     interval(date('17/10/2024')-date("Organisation Staff.Return Date")) as [Aurion Long Term Leave]
	if(("Organisation Staff.Return Date"-today())>=60,'Yes','No') as [Aurion Long Term Leave]
    
FROM [lib://AppDataProd/AzureDataLake/AURION/Organisation Staff.qvd]
(qvd)
// where not match ("Organisation Staff.Location Code",'ACTPPH')
//where ("Organisation Staff.Class Desc" <> 'Contractor' and "Organisation Staff.Organisation Unit Name" <> 'Physical Security')
;


left Join
load
	distinct([Aurion Reports to Position]) as [Aurion Position Number],
    'Yes' as [Aurion Is Supervisor]
resident [temp Organisation Staff]
	where [Aurion Employee Status] = 'ACTIVE'
;



[Aurion Staff]:
NoConcatenate Load
	*
Resident [temp Organisation Staff]
	where [Aurion Is Supervisor] = 'Yes' 
		or [Aurion Position Occupied] = 'Yes' 
		or  [Aurion Employee Status]='ACTIVE'        
;


drop tables 
	[temp Organisation Staff]
;





///$tab 08 - Expense8
LIB CONNECT TO 'AzureDbProdNIAADL';

[TempTrip]:
LOAD
//do this autonumber to make a unique ID
	Autonumber(Trip_ID &Traveller_First_Name & Traveller_Last_Name &Guest_Traveller_First_Name &Guest_Traveller_Last_Name) as UniqueTripId,
	Trip_ID as [Trip ID], 
	Trip_Name as [Trip Name], 
	Creation_Date as [Trip Creation Date], 
	Departure_Date as [Trip Departure Date], 
    year(Departure_Date) as [Trip Year],
	Return_Date as [Trip Return Date], 
	Traveller_AGS_Number as [Traveller AGS Number], 
	Traveller_First_Name as [Traveller First Name], 
	Traveller_Last_Name as [Traveller Last Name], 
	Guest_Traveller_First_Name as [Traveller Guest First Name], 
	Guest_Traveller_Last_Name as [Traveller Guest Last Name], 
    IF (len(trim(Guest_Traveller_First_Name))<=1 and len(trim(Guest_Traveller_Last_Name))<=1,'No','Yes') as [Trip includes Guest],
	Delegate_Arranger_EmployeeID as [Trip Delegate Emlpoyee ID], 
	Trip_Type as [Trip Type], 
	Online_Offline as [Trip Online_Offline], 
	Trip_Status as [Trip Status];


SELECT "Trip_ID",
	"Trip_Name",
	"Creation_Date",
	"Departure_Date",
	"Return_Date",
	"Traveller_AGS_Number",
	"Traveller_First_Name",
	"Traveller_Last_Name",
	"Guest_Traveller_First_Name",
	"Guest_Traveller_Last_Name",
	"Delegate_Arranger_EmployeeID",
	"Trip_Type",
	"Online_Offline",
	"Trip_Status"
FROM "AZDB-AUE-PRD-NIAADL01".Exp8.Trip
WHERE Trip_Status IN ('APPROVED', 'FINALISED')
;


left Join
load
	[Aurion Employee Number] as [Traveller AGS Number],
    [Aurion Class Group] as [Traveller Class Group]
resident [Aurion Staff]
	;




[TempSegment]:
LOAD distinct
	Autonumber(Segment_Type &Trip_ID & Trip_Departure_Date &Trip_Return_Date &Segment_Departure&Origin&Segment_Ends&Destination&Origin_Latitude&Origin_Longitude) as UniqueSegmentId,
    Segment_Type as [Trip Segment Type], 
	Trip_ID as [Trip ID], 
	Trip_Departure_Date, 
	Trip_Return_Date as [Trip Segment Return Date], 
	Segment_Departure as [Trip Segment Departure Date], 
	Origin as [Trip Segment Origin], 
	Segment_Ends as [Trip Segment End Date], 
	Destination as [Trip Segment Destination], 
// 	Origin_Latitude, 
// 	Origin_Longitude, 
    GeoMakePoint(Origin_Latitude, Origin_Longitude) AS [Trip Segment Origin Location],
// 	Origin_GEOCODE_SCORE, 
// 	Destination_Latitude, 
// 	Destination_Longitude, 
    GeoMakePoint(Destination_Latitude, Destination_Longitude) AS [Trip Segment Destination Location]
// 	Destination_GEOCODE_SCORE
	;


SELECT "Segment_Type",
	"Trip_ID",
	"Trip_Departure_Date",
	"Trip_Return_Date",
	"Segment_Departure",
	Origin,
	"Segment_Ends",
	Destination,
	"Origin_Latitude",
	"Origin_Longitude",
	"Origin_GEOCODE_SCORE",
	"Destination_Latitude",
	"Destination_Longitude",
	"Destination_GEOCODE_SCORE"
FROM "AZDB-AUE-PRD-NIAADL01".Exp8.Segment
WHERE Segment_Type is not null
AND
Segment_Type not IN ('Business Commitment','Personal Commitment','Other','Taxi','Own Car','-')
;

//Check if segment has a trip
left Join
load
distinct [Trip ID], 
[Trip Name] as [CheckTrip]
resident [TempTrip]
;


//drops segments with no trips
[Segment]:
noconcatenate load
*
resident [TempSegment]
Where Len([CheckTrip])>0
;

drop table [TempSegment];


//This goes after segment to check if a trip has a segment - there is no unique primary key in trip table :(
//It also cleans up some private fields etc
[Temp Trip2]:
NoConcatenate Load 
	UniqueTripId,
	[Trip ID], 
	[Trip Name], 
	[Trip Creation Date], 
	[Trip Departure Date], 
    [Trip Year],
	[Trip Return Date], 
	[Traveller AGS Number], 
// 	[Traveller First Name], 
// 	[Traveller Last Name], 
// 	[Traveller Guest First Name], 
// 	[Traveller Guest Last Name], 
    [Trip includes Guest],
	[Trip Delegate Emlpoyee ID], 
	[Trip Type], 
	[Trip Online_Offline], 
	[Trip Status],
    IF (IsNull([Traveller Class Group]), 'No Current Aurion Record', [Traveller Class Group]) as [Traveller Class Group]
resident [TempTrip]
;

drop table [TempTrip];


left Join
load
distinct [Trip ID], 
[Trip Segment Type] as [CheckSegment]
resident [Segment]
;




//drops trips with no segments
[Trip]:
noconcatenate load
*
resident [Temp Trip2]
Where Len([CheckSegment])>0
;

drop table [Temp Trip2];

///$tab Fleet
//Gets the start and end points
[Fleet trips]:
LOAD
    "Fleet Detail.Fleet Trip Id" as [shape_pt_sequence],
//     "Fleet Detail.Vehicle",
    "Fleet Detail.Registration" as [Fleet Car Rego],
//     "Fleet Detail.VehicleGroup",
	"Fleet Detail.ActivityDate" as [Activity Date],
// 	Date#("Fleet Detail.ActivityDate", 'DD/MM/YYYY') as [Activity Date],
//     Year(Date#("Fleet Detail.ActivityDate", 'DD/MM/YYYY'))&'-'&num(Month(Date#("Fleet Detail.ActivityDate", 'DD/M/YYYY'))) as [Fleet Activity YearMonth],
    Year("Fleet Detail.ActivityDate") as [Fleet Activity Year],
    Month("Fleet Detail.ActivityDate") as [Fleet Activity Month],
//     Month(Date#("Fleet Detail.ActivityDate", 'DD/M/YYYY')) as [Activity Month],
//     "Fleet Detail.EventType",
//     "Fleet Detail.EventTime",
//     "Fleet Detail.TripDistance",
//     "Fleet Detail.TripUnit",
//     "Fleet Detail.OnSiteTime",
//     "Fleet Detail.HDOP",
//     "Fleet Detail.NumSatellites",
//     "Fleet Detail.Channel",
//     "Fleet Detail.Location",
    "Fleet Detail.Latitude" as shape_pt_lat,
    "Fleet Detail.Longitude" as shape_pt_lon
FROM [lib://AppDataProd/AzureDataLake/NIAA/Fleet Detail.qvd]
(qvd)
//Leave out the tiny trips
where "Fleet Detail.TripDistance" > '1.4'
//leave out some bogus coords
and "Fleet Detail.Latitude" < '0.0'
and "Fleet Detail.Longitude" > '0.0'
//Leave out where car coords revert to Sydney CBD
and not match("Fleet Detail.Latitude", '-33.81163','-33.81155')
and not match("Fleet Detail.Longitude",'150.91871','150.91862')
and not match("Fleet Detail.Fleet Trip Id", '841673','755367','755368','755369','755370','755371','755372',
'20043','20044','20049'
,'757619','757622','757623','757624'
,'784700','784701','784702','784703','784704','784705','784706','784707','784708','784709','784710','784711','784712','784713','784714','784715','784716','784717','784718','784719','784720','784721','784722','784723','784724','784725','784726'
)
;


// exit script;



//Turns the start and ends into lines sequentially
[Lines]:
LOAD 	[Fleet Car Rego],
		[Fleet Activity Year],

[Fleet Car Rego] * 10000 + shape_pt_sequence as shape_seg_id,

GeoMakePoint(shape_pt_lat,shape_pt_lon) as shape_pt,

[shape_pt_sequence]

Resident [Fleet trips];
drop table [Fleet trips];



//Puts the lines together so there is only one per Rego
TempFleetGPS:
load

Distinct 	[Fleet Car Rego],
			[Fleet Activity Year],

'[' & concat(shape_pt,',',shape_pt_sequence) & ']' as FleetLine

Resident Lines

group by [Fleet Car Rego], [Fleet Activity Year];

drop table Lines;


FleetGPS:
Load
*,
Autonumber([Fleet Car Rego]&[Fleet Activity Year]) as RegYearKey
resident TempFleetGPS
;

drop table TempFleetGPS
;








//These are the records of the actual cars - they join to Sites using FleetALC (which is duplicated on the Site side from ALC to avoid circular references)
[Fleet Cars]:
LOAD
    "Fleet.Fleet Id" as [Fleet ID],
    Fleet.Rego as [Fleet Car Rego],
    Fleet.Make as [Make],
    Fleet.Model as [Model],
    Fleet.Group as [Fleet Group],
    Fleet.Car_Location as [Fleet Car Locations],
    "Fleet.Aurion Location Code" as [Aurion Location Code]
FROM [lib://AppDataProd/AzureDataLake/NIAA/Fleet.qvd]
(qvd);



[Fleet Stops]:
LOAD
    Autonumber("Fleet Detail.Registration"&"Fleet Detail.ActivityDate"&"Fleet Detail.OnSiteTime"&"Fleet Detail.Latitude"&"Fleet Detail.Longitude") as FleetStopId,
	Autonumber("Fleet Detail.Registration"&Year("Fleet Detail.ActivityDate")) as RegYearKey,
	"Fleet Detail.Registration" as [Fleet Car Reg],
//     "Fleet Detail.VehicleGroup",
    "Fleet Detail.ActivityDate" as [Fleet Stop Date],
    Year("Fleet Detail.ActivityDate") as [Fleet Stop Year],
//     "Fleet Detail.EventType",
//     "Fleet Detail.EventTime",
//     "Fleet Detail.TripDistance",
//     "Fleet Detail.TripUnit",
    "Fleet Detail.OnSiteTime" as [Fleet Stop Time],
//     "Fleet Detail.HDOP",
//     "Fleet Detail.NumSatellites",
//     "Fleet Detail.Channel",
//     "Fleet Detail.Location",
//     "Fleet Detail.Latitude" as [Fleet Stop Lat],
//     "Fleet Detail.Longitude" as [Fleet Stop Lon],
    GeoMakePoint("Fleet Detail.Latitude","Fleet Detail.Longitude") as [Stop Location]
FROM [lib://AppDataProd/AzureDataLake/NIAA/Fleet Detail.qvd]
(qvd)
// where not IsNull("Fleet Detail.OnSiteTime")
// and not match("Fleet Detail.OnSiteTime", 'Unknown','01 min')
where wildmatch( "Fleet Detail.OnSiteTime", '*hr*')
and "Fleet Detail.Latitude" < 0
and "Fleet Detail.Longitude" > 0
;



