LOAD
    "Grant Activity Performance Indicator.Activity Performance Indicator Id"		   			as [Activity Performance Indicator Id],
    "Grant Activity Performance Indicator.Activity Id"											as [Performance Indicator Activity Id],
    "Grant Activity Performance Indicator.Review Item Number"									as [Performance Indicator Review Item Number],
