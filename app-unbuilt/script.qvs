///$tab Site Visits
[Site Visit Assessment]:
LEFT KEEP ([Grant Activity Milestone])
LOAD
    "Site Visit Assessment.Site Visit Assessment Id%"								AS [Site Visit Assessment Id%],
//    "Site Visit Assessment.Grant Activity Id%"										AS [Grant Activity Id%],
//    "Site Visit Assessment.Grant Activity",
//    "Site Visit Assessment.Activity Risk Assessment Id%",
//    "Site Visit Assessment.Current ARA",
    "Site Visit Assessment.Action Items Recommended"								AS [Site Visit Action Items],
//    "Site Visit Assessment.Approval Comments",
//    "Site Visit Assessment.Approved On",
//    "Site Visit Assessment.Approver Id%",
//    "Site Visit Assessment.Approver",
//    "Site Visit Assessment.Approver Classification",
//    "Site Visit Assessment.Approver Location",
    "Site Visit Assessment.Assessed On"												AS [Site Visit Date],
    "Site Visit Assessment.Assessment Completed"									AS [Site Visit Completed],
    "Site Visit Assessment.Assessment Id" 											as [Site Visit Id],
//    "Site Visit Assessment.Assessment Rating Code",
    IF(ISNULL("Site Visit Assessment.Assessment Rating"),'Not Rated',
    	"Site Visit Assessment.Assessment Rating")									AS [Site Visit Rating],
//    "Site Visit Assessment.Assessor Id%",
    "Site Visit Assessment.Assessor"												AS [Site Visit Engagement Officer],
//    "Site Visit Assessment.Assessor Office",
    "Site Visit Assessment.Attended Site Visits"									AS [Site Visit Attended],
//    "Site Visit Assessment.Consultation Undertaken",
    "Site Visit Assessment.Description"												AS [Site Visit Description],
//    "Site Visit Assessment.Document Links",
    "Site Visit Assessment.Findings"												AS [Site Visit Findings],
    "Site Visit Assessment.GPS Updates Finalised On"								AS [Site Visit GPS Updated Date],
//    "Site Visit Assessment.Is Reverted",
//    "Site Visit Assessment.Milestone Completed",
//    "Site Visit Assessment.Name"													AS [Site Visit Name],
    "Site Visit Assessment.Notified On"												AS [Site Visit Notified Date],
//    "Site Visit Assessment.Organisation Id%",
//    "Site Visit Assessment.Organisation",
    "Site Visit Assessment.Process Stage"											as [Process Stage],
    IF("Site Visit Assessment.Process Stage" = 'Awaiting GPS Update'
    OR "Site Visit Assessment.Process Stage" = 'Awaiting GPS Update',
    'Grants Management Unit','Engagement Office') 									as [Responsible Office],
//    "Site Visit Assessment.Revert Reason",
//    "Site Visit Assessment.Reviewed Acquittals",
//    "Site Visit Assessment.Reviewed Existing Action Items",
//    "Site Visit Assessment.Reviewed Latest PRA And KPIs",
//    "Site Visit Assessment.Scheduled Site Visits",
//     IF([Site Visit Assessment.Valid Milestone Id] = 0
//     	OR LEN("Site Visit Assessment.Milestone Id") < 1
//     	, "Site Visit Assessment.Assessment Id"
//         ,"Site Visit Assessment.Site Visit Milestone Id%")							as [Activity Milestone Id%],
     IF([Site Visit Assessment.Valid Milestone Id] = 0
    	OR LEN("Site Visit Assessment.Milestone Id") < 1
    	, "Site Visit Assessment.Assessment Id"
        ,"Site Visit Assessment.Milestone Id")										AS [Milestone Id],
//		"Site Visit Assessment.Milestone Id"										AS [Milestone Id],
//    "Site Visit Assessment.Site Visit Milestone",
//    "Site Visit Assessment.Site Visit Report Approved",
//    "Site Visit Assessment.Site Visit Reports Linked",
//    "Site Visit Assessment.Summary Report Sent to Provider",
    "Site Visit Assessment.State",
    "Site Visit Assessment.Status"													AS [Site Visit Status]
FROM [lib://AppData/PROD/AzureDataLake/FUSION/Site Visit Assessment.qvd]
(qvd);


[Site Visit Responsible Office Temp]:
LOAD
    [Site Visit Assessment Id%],
 //   [Activity Milestone Id%],
    [Milestone Id],
    [Responsible Office]
Resident [Site Visit Assessment];
LEFT JOIN 
LOAD	
    [Milestone Id],
	[Activity Id]
RESIDENT [Grant Activity Milestone];
LEFT JOIN 
LOAD
	[Activity Id],
	[Grants Management Unit Id%],
	[Engagement Office Id%]
Resident [Grant Activity];

[Site Visit Region Link]:
Load
	[Site Visit Assessment Id%],
    IF( [Responsible Office] = 'Grants Management Unit',
    	[Grants Management Unit Id%],
    [Engagement Office Id%])														AS [Site Visit Office Id%]
Resident [Site Visit Responsible Office Temp];

Drop Table [Site Visit Responsible Office Temp];
// Drop Table [Grant Activity Milestone Temp];

[Site Visit Location]:
LOAD
    "Site Visit Location.Site Visit Location Id%"									as [Site Visit Location Id%],
