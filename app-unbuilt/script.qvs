// 	ERP_Males_35_44_years, 
// 	ERP_Males_45_54_years, 
// 	ERP_Males_55_years_and_over, 
// 	ERP_Males_total, 
// 	ERP_Females_0_14_years, 
// 	ERP_Females_15_24_years, 
// 	ERP_Females_25_34_years, 
// 	ERP_Females_35_44_years, 
// 	ERP_Females_45_54_years, 
// 	ERP_Females_55_years_and_over, 
// 	ERP_Females_total, 
// 	ERP_Persons_0_14_years, 
// 	ERP_Persons_15_24_years, 
// 	ERP_Persons_25_34_years, 
// 	ERP_Persons_35_44_years, 
// 	ERP_Persons_45_54_years, 
// 	ERP_Persons_55_years_and_over, 
// 	LAN_Speakers_of_ATSI_language_who_identify_as_ATSI_Perc, 
// 	LAN_Speaks_English_at_home_Perc, 
// 	EET_Fully_engaged_Perc, 
// 	EET_Partially_or_at_least_partially_engaged_Perc, 
// 	EET_Not_engaged_Perc, 
	LFS_Employed, 
// 	LFS_Total_labour_force_employed_Perc, 
	LFS_Unemployed, 
// 	LFS_Total_labour_force_unemployed_Perc, 
	LFS_In_the_labour_force, 
// 	LFS_Labour_force_participation_rate_Perc, 
// 	LFS_Not_in_the_labour_force_Perc, 
	LFS_Total_responding_population_aged_15_64_years, 
