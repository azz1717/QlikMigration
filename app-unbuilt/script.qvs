///$tab 02 - NIAA Sites
[NIAA Office Locations]:
LOAD
    "Aurion Location Code" as [Aurion Location Code],
    "Office Name" as [Office Name],
    "Site Status",
    "Building Name",
    "Site Street Address",
    "Site Suburb",
    "Site State",
    "Site Post Code",
    "Site Locations Latitude",
    "Site Locations Longitude",
    GeoMakePoint("Site Locations Latitude", "Site Locations Longitude") AS [NIAA Site Location],
    "HSR Work Group",
    "Site Phone Number",
    "Site Type",
    "Site Workpoints",
    "Site Anchored Desks",
    "Mesh Block Code 2021" as [MB Code]
FROM [lib://AppData/PROD/AzureDataLake/AURION/NIAA Site Locations.qvd]
(qvd)
where "Site Status" = 'ACTIVE'
and not match ("Aurion Location Code",'ACTPPH')
;






