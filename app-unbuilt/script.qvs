I///$tab 00-Main
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='DD/MM/YYYY';
SET TimestampFormat='DD/MM/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET CreateSearchIndexOnReload=1;
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';
SET NumericalAbbreviation='3:k;6:M;9:B;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';

Set HideSuffix = '%';

Let vFinYearF3 = Replace(YearName(AddMonths(Today(),36),0,7), '-20','-');
Let vFinYearF2 = Replace(YearName(AddMonths(Today(),24),0,7), '-20','-');
Let vFinYearF1 = Replace(YearName(AddMonths(Today(),12),0,7), '-20','-');
Let vFinYear0= Replace(YearName(Today(),0,7), '-20','-');
Let vFinYearP1 = Replace(YearName(AddMonths(Today(),-12),0,7), '-20','-');
Let vFinYearP2 = Replace(YearName(AddMonths(Today(),-24),0,7), '-20','-');
Let vFinYearP3 = Replace(YearName(AddMonths(Today(),-36),0,7), '-20','-');
Let vFinYearP4 = Replace(YearName(AddMonths(Today(),-48),0,7), '-20','-');
Let vFinYearP5 = Replace(YearName(AddMonths(Today(),-60),0,7), '-20','-');
///$tab 01-Var
//These are used to toggle map stuff on/off in the UI - one for each layer
set vMapBoundaries = 'ABS Indigenous Structure';
set vIREG = '0';
set vIARE = '0';
set vILOC = '0';
set vILOCCent = '0';
set vILUA = '0';
set vNIAAReg = '1';
set vNIAASReg = '0';
set vFADA = '0';
set vNT = '0';
set vFAN = '0';
set vFAO = '0';
set vNTD = '0';
set vNTDA = '0';
set vNTDAs = '0';
set vs31 = '0';
set vRATSIB = '0';
set vRNTBC = '0';
set vNIAAGrantAtt = '0';
set vAGIL = '0';
set vCED = '0';
set vNIAASite = '0';
set vState = '0';
set vLGA = '0';
set vEC = '0';
set vFleet = '0';
set vCDP = '0';
set vSiteVisit = '0';
set vOrganisation = '0';
set vATSIlanguage = '0';
set vNACCHO = '0';
set vSAOffice = '0';
set vSA2 = '0';
set vNTAdmin = '0';
set vClosestOfficeOffice = '0';
set v250kmFromOffice = '0';
set vTrip = '0';





//For the Matrix weighting sheet
set vPopWeight = 30;
set vIRSEOWeight = 40;
set vRemoteWeight = 30;

//Old region boundaries ew
set vOLDNIAAReg = '0';
set vOLDNIAAReg2 = '0';

///$tab TEST EDIT CLI
//tab added throught cli

///$tab 05 - AGIL
[AGIL]:
LOAD
    "AGIL Location Id" as [AGIL Id%],
    "AGIL Location Code" as [AGIL Code],
    IF("Preferred Location Name" = 'SUBDIVISION', 'BORROLOOLA', "Preferred Location Name") as [AGIL Preferred Name],
    "Alternative Location Names" as [Alternative AGIL Names],
	GeoMakePoint([Latitude], [Longitude]) AS [AGIL Location],
    "Mesh Block Code 2021" as [MB Code 2021]

//     "AGIL Location Id",
//     "AGIL Location Code",
//     "Preferred Location Name",
//     "Alternative Location Names",
//     "State/Territory",
//     Latitude,
//     Longitude,
//     "Mesh Block Code 2016",
//     "Mesh Block Code 2021",
//     "Jurisdictional Link",
//     "Date Created"
FROM [lib://Curated Data Store - DEV:DataFiles/10 Landing Area/AGIL/AGIL Location.qvd]
(qvd);





// //[AGIL Connectivity]:
// Left join
// LOAD
//     "AGIL_Connectivity.AGIL Code" as [AGIL Code],
// //     "AGIL_Connectivity.Name Code",
// //     "AGIL_Connectivity.AGIL Preferred Name",
//     "AGIL_Connectivity.NBN Fixed Line" as [NBN Fixed Line],
//     "AGIL_Connectivity.NBN Fixed Wireless" as [NBN Fixed Wireless],
//     "AGIL_Connectivity.Optus 3G or 4G" as [Optus 3G or 4G],
//     "AGIL_Connectivity.Optus 5G" as [Optus 5G],
//     "AGIL_Connectivity.Telstra 3G or 4G" as [Telstra 3G or 4G],
//     "AGIL_Connectivity.Vodafone 3G or 4G" as [Vodafone 3G or 4G]
// FROM [lib://AppDataProd/AzureDataLake/NIAA/AGIL_Connectivity.qvd]
// (qvd);





///$tab motherload
LOAD *
FROM [lib://Curated Data Store:DataFiles/30 Curated Data Store/Geospatial Reporting/*.qvd]
(qvd);

//LOAD *
//FROM [lib://Data Preparation - DEV:DataFiles/30 Curated Data Store/Funding Decision/*.qvd]
//(qvd);

LOAD *
FROM [lib://Curated Data Store - DEV:DataFiles/30 Curated Data Store/Economic Indicators/*.qvd]
(qvd);




LOAD *
FROM [lib://Curated Data Store:DataFiles/30 Curated Data Store/Grant Management/*.qvd]
(qvd);


///$tab Language
// [ATSI Language]:
// LOAD
//     "ATSI Language.Id" as [ATSI Language Id],
//     "ATSI Language.Language Code" as [ATSI Language Code],
//     "ATSI Language.Language" as [ATSI Language],
//     "ATSI Language.Language Synonym" as [ATSI Language Synonym],
//     "ATSI Language.Heading Language" as [ATSI Heading Language],
//     "ATSI Language.People" as [ATSI Language People],
//     "ATSI Language.Latitude" as [ATSI Language Lattitude],
//     "ATSI Language.Longitude" as [ATSI Language Longitude],
//     "ATSI Language.State/Territories" as [ATSI Language State/Territories],
//     "ATSI Language.URL" as [ATSI Language URL],
//     "ATSI Language.Mesh Block Code 2021" as [MB Code],
//     "ATSI Language.GeoPoint" as [ATSI Language Location]
// FROM [lib://AppDataProd/Geospatial/ATSI Language.qvd]
// (qvd);

// [ATSI Language]:
// LOAD
//     Id as [ATSI Language Id],
//     language_code as [ATSI Language Code],
//     language_name as [ATSI Language],
//     language_synonym as [ATSI Language Synonym],
//     thesaurus_heading_language as [ATSI Heading Language],
//     thesaurus_heading_people as [ATSI Language People],
//     approximate_latitude_of_language_variety as [ATSI Language Lattitude],
//     approximate_longitude_of_language_variety as [ATSI Language Longitude],
//     state_territory as [ATSI Language State/Territories],
//     uri as [ATSI Language URL],
//     MeshBlockCode2021 as [MB Code 2021],
//     Geometry as [ATSI Language Location]
// FROM [lib://Curated Data Store - DEV:DataFiles/10 Landing Area/AIATSIS/AUSTLANG_vw.qvd]
// (qvd);





