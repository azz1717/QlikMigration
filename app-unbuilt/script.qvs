///$tab ABS Remoteness x ILOC
[2021 ABS Remoteness x ILOC]:
LOAD
    text("ILOC Code") as [ILOC Code],
    "Remoteness Name",
    "Remoteness Proportion",
    "Remoteness Score",
    "Prefixed Remoteness Score"
FROM [lib://AppDataProd/AzureDataLake/ABS/2021 ABS Remoteness x ILOC.qvd]
(qvd);






