///$tab Grant Activity Engagement Office
[NIAA Region - Staging]:
LOAD
    "PMC Region.PMC Region Id%"													AS "NIAA Region Id%",
     IF(MATCH("PMC Region.PMC Region Abbr",'FNQLD','GNQLD')
     	,'B', "PMC Region.PMC Region Code")										AS "NIAA Region Code",
     IF(MATCH("PMC Region.PMC Region Abbr",'FNQLD','GNQLD')
        ,'North Queensland',
        Replace(
          REPLACE("PMC Region.PMC Region",' - GMU','')
          	,'ABA','Aboriginals Benefit Account')
        ) 																		AS "NIAA Region",
    IF(MATCH("PMC Region.PMC Region Abbr",'FNQLD','GNQLD')
     	,'NQLD', "PMC Region.PMC Region Abbr")									AS "NIAA Region Abbr",
   IF("PMC Region.PMC Region" like '*GMU*', 'GMU', 'EO')						AS "NIAA Region Type"
//     "PMC Region.State",
//     "PMC Region.Regional Manager",
//     "PMC Region.Regional Manager Email",
//     "PMC Region.Regional Manager Business Phone",
//     "PMC Region.Regional Manager Mobile"
FROM [lib://AppData/PROD/AzureDataLake/FUSION/PMC Region.qvd]
(qvd);

CONCATENATE Load								
	'Mismatch' 																	AS "NIAA Region Id%",
    'Unallocated'																AS "NIAA Region Code",
    'Unallocated'																AS "NIAA Region",
    'Unall'																		AS "NIAA Region Abbr",
    'Unallocated'																AS "NIAA Region Type"

FROM [lib://AppData/PROD/AzureDataLake/FUSION/PMC Region.qvd]
(qvd);




[Engagement Region]:
Load
	 "NIAA Region Id%"																AS [Engagement Office Id%],
     IF("NIAA Region Type" = 'GMU','Grants Management Unit',"NIAA Region")			AS [Engagement Office],					//Only NIAA Regions that have a Engagement Office designation
     IF("NIAA Region Type" = 'GMU','GMU',"NIAA Region Abbr")						AS [Engagement Office - Abbr],
     "NIAA Region"																	AS [Engagement Region],					//All NIAA Regions regardless of GMU or Engagement Office designation
     "NIAA Region Code"																AS [Engagement Office Code]					
Resident [NIAA Region - Staging];


Drop table [NIAA Region - Staging];
///$tab Grant Activity Coding
[CtG Activity Coding]:
Left Keep ([Grant Activity])

LOAD
    "Grant Activity Coding.Grant Activity Coding Id%"								as [Grant Activity Coding Id%],
    "Grant Activity Coding.Grant Activity Id%"										as [Grant Activity Id%],
    "Grant Activity Coding.Nature of Activity" 										as [Nature of Activity],
    "Grant Activity Coding.Total Funding" 											as [Total Funding],
    "Grant Activity Coding.Framework Code Allocation Total"							as [Framework Code Allocation Total],
//     "Grant Activity Coding.Status"													as [Grant Activity Coding Status],
    "Grant Activity Coding.Date Approval Submitted"									as [Grant Activity Date Approval Submitted],
    "Grant Activity Coding.Date Approval Completed"									as [Grant Activity Date Approval Completed],
    "Grant Activity Coding.Approver"												as [Grant Activity Approver],
    "Grant Activity Coding.Approver Comment"										as [Grant Activity Approver Comment],
    "Grant Activity Coding.Coder"													as [Grant Activity Coder],
    "Grant Activity Coding.Coder Comment"											as [Grant Activity Coder Comment],
    "Grant Activity Coding.Outcome Selection One"									as [CTG Target One],
	"Grant Activity Coding.Outcome Allocation One"									as [CTG Allocation One],
    "Grant Activity Coding.Outcome Selection Two"									as [CTG Target Two],
    "Grant Activity Coding.Outcome Allocation Two"									as [CTG Allocation Two],
    "Grant Activity Coding.Outcome Selection Three"									as [CTG Target Three],
    "Grant Activity Coding.Outcome Allocation Three"								as [CTG Allocation Three],
    "Grant Activity Coding.Outcome Total Allocation"								as [Grant Activity Outcome Total Allocation],
    "Grant Activity Coding.Primary Priority Reform"									as [Priority Reform One],
    "Grant Activity Coding.Secondary Priority Reform"								as [Priority Reform Two]
FROM [lib://AppDataProd/AzureDataLake/FUSION/Grant Activity Coding.qvd]
(qvd)

Where "Grant Activity Coding.Status" = 'Approved';

// [CTG Outcome One Description]:
left join
LOAD * Inline [

"CTG Target One", "CTG Target One Outcome Description", "Sector"


"Outcome Area 1",	"Aboriginal and Torres Strait Islander people enjoy long and healthy lives.",	"Health and Wellbeing"
"Outcome Area 2",	"Aboriginal and Torres Strait Islander children are born healthy and strong.",	"Health and Wellbeing"
"Outcome Area 3",	"Aboriginal and Torres Strait Islander children are engaged in high quality, culturally appropriate early childhood education in their early years.",	"Early Years and Education"
"Outcome Area 4",	"Aboriginal and Torres Strait Islander children thrive in their early years.",	"Early Years and Education"
"Outcome Area 5",	"Aboriginal and Torres Strait Islander students achieve their full learning potential.",	"Early Years and Education"
"Outcome Area 6",	"Aboriginal and Torres Strait Islander students reach their full potential through further education pathways.",	"Early Years and Education"
"Outcome Area 7",	"Aboriginal and Torres Strait Islander youth are engaged in employment or education.",	"Economic Participation"
"Outcome Area 8",	"Strong economic participation and development of Aboriginal and Torres Strait Islander people and communities.",	"Economic Participation"
"Outcome Area 9",	"Aboriginal and Torres Strait Islander people secure appropriate, affordable housing that is aligned with their priorities and need.",	"Housing and Digital Inclusion"
"Outcome Area 10",	"Aboriginal and Torres Strait Islander adults are not overrepresented in the criminal justice system.",	"Justice"
"Outcome Area 11",	"Aboriginal and Torres Strait Islander young people are not overrepresented in the criminal justice system.",	"Justice"
"Outcome Area 12",	"Aboriginal and Torres Strait Islander children are not overrepresented in the child protection system.",	"Safety and Child Protection"
"Outcome Area 13",	"Aboriginal and Torres Strait Islander families and households are safe.",	"Safety and Child Protection"
"Outcome Area 14",	"Aboriginal and Torres Strait Islander people enjoy high levels of social and emotional wellbeing.",	"Health and Wellbeing"
"Outcome Area 15",	"Aboriginal and Torres Strait Islander people maintain a distinctive cultural, spiritual, physical and economic relationship with their land and waters.",	"Land, Waters, Culture and Languages "
"Outcome Area 16",	"Aboriginal and Torres Strait Islander cultures and languages are strong, supported and flourishing.",	"Land, Waters, Culture and Languages "
"Outcome Area 17",	"Aboriginal and Torres Strait Islander people have access to information and services enabling participation in informed decision-making regarding their own lives.",	"Housing and Digital Inclusion"
"Not Coded",	"Not Coded",	"Not Coded"
];

[Grant Activity Coding]:
LOAD
    "Grant Activity Coding - Summary.Grant Activity Id%"							as [Grant Activity Id%],
    "Grant Activity Coding - Summary.Activity Coding Level 1"						AS [Activity Coding Level 1],
    "Grant Activity Coding - Summary.Activity Coding Level 2"						AS [Activity Coding Level 2],
    "Grant Activity Coding - Summary.Activity Coding Level 3"						AS [Activity Coding Level 3],
    "Grant Activity Coding - Summary.Activity Coding Percentage Allocation"			AS [Activity Coding Percentage Allocation]
    
FROM [lib://AppDataProd/AzureDataLake/FUSION/Grant Activity Coding - Summary.qvd]
(qvd)
WHERE "Grant Activity Coding - Summary.Activity Coding Status" = 'Approved';









///$tab GAR
[Grant Activity Review]:
LOAD
	[Grant Activity Review.Grant Activity Review Id%] AS [GAR Grant Activity Review Id%],
	[Grant Activity Review.Grant Activity Id%] AS [Grant Activity Id%],
	[Grant Activity Review.Activity Id],
	[Grant Activity Review.Grant Activity Review Item Id%] AS [Grant Activity Review Item Id%],
	[Grant Activity Review.Sort Order],
	[Grant Activity Review.Data],
	[Grant Activity Review.Additional Evidence]
 FROM [lib://AppData/PROD/AzureDataLake/GAR/Grant Activity Review.qvd]
(qvd);

[Grant Activity Review Item]:
LOAD
	[Grant Activity Review Item.Grant Activity Review Item Id%] AS [Grant Activity Review Item Id%],
	[Grant Activity Review Item.Review Category],
	[Grant Activity Review Item.Review Item Number],
	[Grant Activity Review Item.Review Item],
	[Grant Activity Review Item.Descriptor Option Number],
	[Grant Activity Review Item.Descriptor Option],
	[Grant Activity Review Item.Explanation]
 FROM [lib://AppData/PROD/AzureDataLake/GAR/Grant Activity Review Item.qvd]
(qvd);

[Grant Activity Review KPI]:
LOAD
	[Grant Activity Review KPI.Grant Activity Review KPI Id%],
	[Grant Activity Review KPI.Grant Activity Review Id%] AS [GAR Grant Activity Review Id%],
	Date(Date#([Grant Activity Review KPI.IAS Performance Report Start Date], 'YYYY-DD-MM') ) AS [Grant Activity Review KPI.IAS Performance Report Start Date],
	Date(Date#([Grant Activity Review KPI.IAS Performance Report End Date], 'YYYY-MM-DD') ) AS [Grant Activity Review KPI.IAS Performance Report End Date],
	Date(Date#([Grant Activity Review KPI.PMC Performance Report Start Date], 'YYYY-DD-MM') ) AS [Grant Activity Review KPI.PMC Performance Report Start Date],
	Date(Date#([Grant Activity Review KPI.PMC Performance Report End Date], 'YYYY-MM-DD') ) AS [Grant Activity Review KPI.PMC Performance Report End Date],
	[Grant Activity Review KPI.KPI Code],
	[Grant Activity Review KPI.KPI Description],
	[Grant Activity Review KPI.IAS Performance Report Status],
	[Grant Activity Review KPI.PMC Status],
	[Grant Activity Review KPI.Further Information],
	[Grant Activity Review KPI.Evidence]
 FROM [lib://AppData/PROD/AzureDataLake/GAR/Grant Activity Review KPI.qvd]
(qvd);




///$tab Performance
[Grant Activity Performance]:
LEFT KEEP ([Grant Activity])
LOAD 
//     "Grant Activity Performance.Activity Id" 						AS [Activity Id],
    "Grant Activity Performance.Milestone Id"	AS [Milestone Id],
    "Grant Activity Performance.Review Id"	AS [Performance Review Id],
    "Grant Activity Performance.Review Title"	AS [Performance Review Title],
    "Grant Activity Performance.Review Name"	AS [Performance Review Name],
    "Grant Activity Performance.Review Financial Year"	AS [Performance Review Financial Year],
//     "Grant Activity Performance.Review Stage",
    "Grant Activity Performance.Form Received Date"	AS [Performance Review Form Received Date],
    "Grant Activity Performance.Review Due Date"	AS [Performance Review Due Date],
    "Grant Activity Performance.Review Start Date"	AS [Performance Review Start Date],
    "Grant Activity Performance.Review End Date"	AS [Performance Review End Date],
//     "Grant Activity Performance.Review Round"	as [Performance Review Round],
    "Grant Activity Performance.Review Round" & ' - ' & "Grant Activity Performance.Review Period" & ' ' & "Grant Activity Performance.Review Round Year"	AS [Performance Review Round],
    "Grant Activity Performance.Review Period"	AS [Performance Review Round Period],
    "Grant Activity Performance.Review Cycle"		AS [Performance Review Cycle],
    "Grant Activity Performance.Review Round Year"	AS [Performance Review Round Year],
//     "Grant Activity Performance.Review No",
    "Grant Activity Performance.Milestone Review Grouping Name"	AS [Performance Review Grouping Name],
    "Grant Activity Performance.Review Status"	AS [Performance Review Status],
    "Grant Activity Performance.Review Status Change Date"	AS [Performance Review Status Date],
    IF([Grant Activity Performance.Review Status] like '*Complete*', [Grant Activity Performance.Review Status Change Date]) AS [Performance Review Completion Date],
    "Grant Activity Performance.Review Result Findings"	AS [Performance Review Result Findings],
    "Grant Activity Performance.Review Result Type"	AS [Performance Review Result Type],
    "Grant Activity Performance.Review Authorised By"	AS [Performance Review Authorised By],
    "Grant Activity Performance.Review Type"	AS [Performance Review Type],
    "Grant Activity Performance.Review Subtype"	AS [Performance Review Subtype],
    IF("Grant Activity Performance.Review Status" like '*Complete*', 'Complete', IF("Grant Activity Performance.Review Due Date"  > TODAY(), 'Future',  'Due'))	AS [Performance Review Stage],
    
    IF("Grant Activity Performance.Review Due Date" <= Today() and "Grant Activity Performance.Review Status" <> 'Complete', Today() - "Grant Activity Performance.Review Due Date", 0) AS [Performance Review Days Overdue],
    IF("Grant Activity Performance.Review Due Date" > Today() and "Grant Activity Performance.Review Status" <> 'Complete',"Grant Activity Performance.Review Due Date" - Today(), 0) AS [Performance Review Days Until Due],
    IF("Grant Activity Performance.Review Status" = 'Complete', Today() - IF([Grant Activity Performance.Review Status] like '*Complete*', [Grant Activity Performance.Review Status Change Date]), 0) AS [Performance Review Days Complete],
    (Floor((IF([Grant Activity Performance.Review Status] like '*Complete*', [Grant Activity Performance.Review Status Change Date]) - "Grant Activity Performance.Review Due Date")/30) * 30)+30 AS [Performance Review Days Complete Bins]
        
    

FROM [lib://AppData\PROD\AzureDataLake\GPS\Grant Activity Performance.qvd] (qvd)
Where not match([Grant Activity Performance.Review Status], 'Cancelled', 'Draft') ;


[Grant Activity Performance History]:

LEFT Keep ([Grant Activity Performance])
LOAD
    "Grant Activity Performance Derived History.End of Month"										AS [Performance Review End of Month],
    Replace(YearName("Grant Activity Performance Derived History.End of Month",0,7), '-20','-')		AS [Performance Review EOM Financial Year],
          Month("Grant Activity Performance Derived History.End of Month")  						AS [Performance Review Month],
      "Grant Activity Performance Derived History.Review Id"										AS [Performance Review Id]
  FROM [lib://AppData/PROD/AzureDataLake/GPS/Grant Activity Performance Derived History.qvd]
(qvd);


[Review Id link]:
Left Keep ([Grant Activity Performance])
LOAD
    "Grant Activity Review.Grant Activity Review Id%"				AS [Grant Activity Review Id%],
