///$tab Grant Activity
[Grant Activity]:
LOAD
    "Grant Activity.Grant Activity Id%" AS [Grant Activity Id%],
    "Grant Activity.Source Organisation Id%" AS [Source Organisation Id%],
//     "Grant Activity.Organisation Id%",
//     "Grant Activity.PMC Region Id%",
IF(LEN( "Grant Activity.PMC Region Id%") < 1, 'Mismatch', "Grant Activity.PMC Region Id%" )	AS [Grants Management Unit Id%],
    "Grant Activity.Programme Component Id%" AS [Programme Component Id%],
//     "Grant Activity.Outcome Element",
//     "Grant Activity.Programme Id%" AS [Activity Programme Id%],
//     "Grant Activity.Program" AS [Program],
// 	IF("Grant Activity.Outcome Element" = 'ABA', 'Aboriginals Benefit Account', "Grant Activity.Program") as [Program],
   // IF("Grant Activity.Outcome Element" = 'ABA', 'Aboriginals Benefit Account', IF(match("Grant Activity.Sub Programme", 'Community Development Program (CDP)', 'CDP - Capability Development', 'CDP Capital Investment'), 'Community Development Program (CDP)', "Grant Activity.Program")) as [Program],
   "Grant Activity.Program" as [Program],
   "Grant Activity.Sub Programme" AS [Subprogram],
    "Grant Activity.Grant Activity" AS [Activity Title],
    "Grant Activity.Grant Activity Status" as [Grant Activity Status],
    "Grant Activity.Activity Id" AS [Activity Id],
    "Grant Activity.Activity Description" as [Activity Description],
//     "Grant Activity.Activity Start Date" as [Activity Start Date],
    DATE("Grant Activity.Activity Start Date", 'DD/MM/YYYY') as [Activity Start Date],
//     "Grant Activity.Activity End Date" as [Activity End Date],
    DATE("Grant Activity.Activity End Date", 'DD/MM/YYYY') as [Activity End Date],
//     "Grant Activity.Activity Duration Days",
//     "Grant Activity.Funding Approved Date",
//     "Grant Activity.Funding Approved By",
//     "Grant Activity.Primary Contact Full Name",
//     "Grant Activity.Primary Contact job Title",
//     "Grant Activity.Primary Contact First Name",
//     "Grant Activity.Primary Contact Last Name",
//     "Grant Activity.Primary Contact",
//     "Grant Activity.Primary Contact Phone",
//     "Grant Activity.Primary Contact Email",
    "Grant Activity.Source System Id%" AS [Source System Id%],
//     "Grant Activity.Source System",
//     "Grant Activity.Source Activity Status",
    "Grant Activity.Activity Manager" as [Activity Manager],
//     "Grant Activity.Approved On Date",
//     "Grant Activity.Draft Coded By Id%",
//     "Grant Activity.Draft Coded By",
//     "Grant Activity.Draft Approver Reject Code",
//     "Grant Activity.Draft Approver Reject",
//     "Grant Activity.Current Performance Outcome Id%",
//     "Grant Activity.Current Performance Outcome",
//     "Grant Activity.Source Status Group Code",
    "Grant Activity.Source Status Group" as [Activity Status],
//     "Grant Activity.Mandatory Submission",
//     "Grant Activity.Current Ceasing Activity Assessment Id%",
//     "Grant Activity.Current Ceasing Activity Assessment",
//     "Grant Activity.Has Review",
//     "Grant Activity.Activity Manager Email",
//     "Grant Activity.Activity Manager User Id",
//     "Grant Activity.Activity Manager User",
//     "Grant Activity.Engagement Office Id",
//     "Grant Activity.Engagement Office" as [Grant Activity Engagement Office],
    IF(LEN("Grant Activity.Engagement Office Id%") < 1, 'Mismatch', "Grant Activity.Engagement Office Id%") AS [Engagement Office Id%],
//     "Grant Activity.Engagement Officer",
//     "Grant Activity.Engagement Officer Email",
//     "Grant Activity.Engagement Officer User Id",
//     "Grant Activity.Engagement Officer User",
//     "Grant Activity.Opportunity Id%" as [Opportunity Id%],
//     "Grant Activity.Opportunity",
//     "Grant Activity.Opportunity No",
//     "Grant Activity.Purchase Order",
    "Grant Activity.Total Funding Amount" as [Activity Total Funding Amount],
//     "Grant Activity.Total Funding Release Ex GST",
    "Grant Activity.Total Funds Released" as [Activity Total Funds Released]
//     "Grant Activity.Variation Identified",
//     "Grant Activity.Active Empowered Community Process"
FROM [lib://AppDataProd/AzureDataLake/FUSION/Grant Activity.qvd]
(qvd)
WHERE "Grant Activity.Outcome Element" <> 'ABA';




left join
