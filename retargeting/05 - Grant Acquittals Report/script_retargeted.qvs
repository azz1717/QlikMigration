///$tab Main
SET ThousandSep = ',';
SET DecimalSep = '.';
SET MoneyThousandSep = ',';
SET MoneyDecimalSep = '.';
SET MoneyFormat = '$#,##0.00;-$#,##0.00';
SET TimeFormat = 'h:mm:ss TT';
SET DateFormat = 'D/M/YYYY';
SET TimestampFormat = 'D/M/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay = 6;
SET BrokenWeeks = 1;
SET ReferenceDay = 0;
SET FirstMonthOfYear = 1;
SET CollationLocale = 'en-AUS';
SET CreateSearchIndexOnReload = 0;
SET MonthNames = 'Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames = 'January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames = 'Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames = 'Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';
SET NumericalAbbreviation = '3:k;6:M;9B;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';
// directory lib://AppData/DEV/AzureDataLake/GPS/; 
	DIRECTORY LIB://AppDataProd/AzureDataLake/GPS/; 
	SET CurrentFinYear = YEARNAME(TODAY(), 0, 7);


SET eFormat = '$' & IF(SUM($1) > 0,
PICK(CEIL(LOG10(SUM($1)) / 3),
                  NUM(SUM($1), '#,##0.0'),
                  NUM(SUM($1) / 1E3, '#,##0.0k'),
                  NUM(SUM($1) / 1E6, '#,##0.00m'),
                  NUM(SUM($1) / 1E9, '#,##0.00b')
), 0);

