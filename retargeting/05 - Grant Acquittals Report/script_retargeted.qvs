// drop table TempAcquittalTest;



///$tab Region
	RegionMap:
	MAPPING LOAD *
	INLINE [Region, Group
	Adelaide - GMU, Central
	Alice Springs - GMU,Central
    Arnhem Land & Groote Eylandt, Central
    Darwin - GMU,	Central
    Central Australia,	Central
    Top End & Tiwi Islands,	Central
    Brisbane - GMU,	Eastern
    Cairns - GMU,	Eastern
    Dubbo - GMU,	Eastern
    Mount Isa - GMU,	Eastern
    Orange - GMU,	Eastern
    Parramatta - GMU,	Eastern
    Tamworth - GMU,	Eastern
    Townsville - GMU,	Eastern
    Eastern NSW,	Eastern
    Eastern New South Wales, Eastern
    Western New South Wales, Eastern
    North Queensland,	Eastern
    South Queensland,	Eastern
    Eastern New South Wales,  Eastern
    Western NSW,	Eastern
    Broome - GMU,	National Office
    Canberra - GMU,	National Office
    Coffs Harbour - GMU,	National Office
    National Office,	National Office
    Adelaide - GMU,	West and South
    Melbourne - GMU,	West and South
    Perth - GMU,	West and South
    Greater Western Australia,	West and South
    Kimberley, West and South
    South Australia,	West and South
    Victoria & Tasmania,	West and South
    GMU Central Support - GMU, National Office
];


	[Grant Managing Region]:
	LOAD
		  [Grant Activity Id%]	 AS [Grant Activity Id%]
		, [NIAA Region Id%]		 AS [PMC Region Id%]
		, [GMU Region Id%]		 AS [GMU Region Id%]
		, [Engegement Officer]	 AS [Engegement Officer]
		, [Source System]		 AS [Source System]
	FROM [lib://AppData/PROD/AzureDataLake/GPS/Grant Managing Region.qvd] (qvd);


	[NIAA Region]:
	LOAD *
		, APPLYMAP('RegionMap', [NIAA Region])	 AS Group;


	LOAD
		  [PMC Region Id]																				 AS [PMC Region Id%]
//		, [PMC Region.PMC Region Code]																				 AS [PMC Region.PMC Region Code]
		, IF(MATCH([PMC Region Abbr], 'FNQLD', 'GNQLD'), [PMC Region])						 AS [NIAA Sub Region]
		, IF(MATCH([PMC Region Abbr], 'FNQLD', 'GNQLD'), [PMC Region Abbr])					 AS [NIAA Sub Region Abbr]
		, IF(MATCH([PMC Region Abbr], 'FNQLD', 'GNQLD'), 'North Queensland', [PMC Region])	 AS [NIAA Region]
		, IF(MATCH([PMC Region Abbr], 'FNQLD', 'GNQLD'), 'NQ', [PMC Region Abbr])				 AS [PMC Region.PMC Region Abbr]
		, [State]																						 AS [PMC Region.State]
//		, [PMC Region.Regional Manager]																				 AS [PMC Region.Regional Manager]
//		, [PMC Region.Regional Manager Email]																		 AS [PMC Region.Regional Manager Email]
//		, [PMC Region.Regional Manager Business Phone]																 AS [PMC Region.Regional Manager Business Phone]
//		, [PMC Region.Regional Manager Mobile]																		 AS [PMC Region.Regional Manager Mobile]
		, IF([PMC Region Abbr] = 'GWA' OR [PMC Region Abbr] = 'KIM' OR [PMC Region Abbr] = 'SA' OR [PMC Region Abbr] = 'VIC/TAS', 'West & South Group',
			IF([PMC Region Abbr] = 'CA' OR [PMC Region Abbr] = 'TETI' OR [PMC Region Abbr] = 'ALGE', 'Central Group',
			IF([PMC Region Abbr] = 'ENSW' OR [PMC Region Abbr] = 'WNSW' OR [PMC Region Abbr] = 'SQLD'
			OR [PMC Region Abbr] = 'FNQLD' OR [PMC Region Abbr] = 'GNQLD', 'Eastern Group', 'National'))) AS [NIAA Region Group]
	FROM [lib://Curated Data Store:DataFiles/10 Landing Area/FUSION/PMC Region.qvd] (qvd);


	[GMU Region]:
	LOAD
		  [PMC Region Id]													 AS [GMU Region Id%]
		, [State]															 AS [GMU State]
		, IF([PMC Region Abbr] = 'GWA' OR [PMC Region Abbr] = 'KIM' OR [PMC Region Abbr] = 'SA' OR [PMC Region Abbr] = 'VIC/TAS', 'West & South Group',
			IF([PMC Region Abbr] = 'CA' OR [PMC Region Abbr] = 'TETI' OR [PMC Region Abbr] = 'ALGE', 'Central Group',
			IF([PMC Region Abbr] = 'ENSW' OR [PMC Region Abbr] = 'WNSW' OR [PMC Region Abbr] = 'SQLD' OR [PMC Region Abbr] = 'FNQLD'
			OR [PMC Region Abbr] = 'GNQLD', 'Eastern Group', 'National')))	 AS [GMU Region Group]
	FROM [lib://Curated Data Store:DataFiles/10 Landing Area/FUSION/PMC Region.qvd] (qvd);
///$tab Milestone
	[Grant Activity Milestone]:
	LET vDaysoverdue = 'IF([Grant Activity Milestone.Milestone Expected Due Date] <= today(), Today() - [Grant Activity Milestone.Milestone Expected Due Date])' ;
LET vEndDate = TEXT('2014-06-30');


//		  LEFT KEEP([Grant Activity Acquittal])
	LOAD $([vDaysoverdue]) AS [Number of Days Milestone Overdue]
		, [Activity Id]														 AS [Grant Activity Milestone.Activity Id]
		, REPLACE(YEARNAME([Milestone Expected Due Date], 0, 7), '-20', '-')	 AS [Milestone Financial Year]
		, [Activity PBS Program]												 AS [Activity PBS Outcome]
		, [Managing Office - Activity]											 AS [Milestone Managing Office%]
		, [Milestone Id]														 AS [Milestone Id]
		, [Milestone Status]													 AS [Grant Activity Milestone.Milestone Status]
		, IF([Milestone Expected Due Date] > TODAY(), 'Overdue', [Milestone Stage]) AS [Grant Activity Milestone.Milestone Stage]
		, [Milestone Completed Indicator]										 AS [Milestone Completed Indicator]
		, [Milestone Payment Mode]												 AS [Milestone Payment Mode]
		, [Milestone Received]													 AS [Grant Activity Milestone.Milestone Received]
		, [Milestone Short Description]										 AS [Grant Activity Milestone.Milestone Short Description]
		, [Milestone Long Description]											 AS [Milestone Long Description]
		, [Milestone Completion Description]									 AS [Milestone Completion Description]
		, [Milestone Type]														 AS [Milestone Type]
		, (FLOOR(([Milestone Completion Date] - [Milestone Expected Due Date]) / 30) * 30) + 30 AS [Days to Complete]
		, [Milestone Expected Due Date]										 AS [Milestones Expected Due Date]
		, [Financial Year Name]												 AS [Grant Activity Milestone.Financial Year Name]
		, [Milestone Action Required]											 AS [Grant Activity Milestone.Milestone Action Required]
		, [Milestone Completion Date]											 AS [Milestone Completion Date]
		, [Activity IMPACT PO Id]												 AS [Grant Activity Milestone.Activity IMPACT PO Id]
		, [Milestone Auto Release Indicator]									 AS [Grant Activity Milestone.Milestone Auto Release Indicator]
		, [Milestone Date Driven Indicator]									 AS [Grant Activity Milestone.Milestone Date Driven Indicator]
		, [Milestone Actual Amount Ex GST]										 AS [Milestone Actual Amount Ex GST]
		, IF([Milestone Expected Due Date] > TODAY(), 0, 1)					 AS [Overdue by Date]
		, IF([Milestone Expected Due Date] <= TODAY(),
			IF([Milestone Stage] = 'Future', 'Overdue - Not received',
			IF([Milestone Stage] = 'Overdue', 'Overdue - Not received',
			IF([Milestone Stage] = 'Received', 'Overdue - Received'))),
			IF([Milestone Expected Due Date] > TODAY(),
			IF([Milestone Stage] = 'Future', 'Future - Not received',
			IF([Milestone Stage] = 'Overdue', 'Future - Not received',
			IF([Milestone Stage] = 'Received', 'Future - Received'))))
			)																							 AS [Stage]
		, IF([Milestone Expected Due Date] < TODAY() + 30 AND [Milestone Expected Due Date] > TODAY(), 1, 0) AS [Due in next 30 Days]
		, IF([Milestone Expected Due Date] < TODAY() + 180 AND [Milestone Expected Due Date] > TODAY(), 1, 0) AS [Due in next 6 Months]
		, IF([Milestone Expected Due Date] < TODAY() + 60 AND [Milestone Expected Due Date] > TODAY() + 30, 1, 0) AS [Due in next 60 Days]
		, IF([Milestone Completion Date] > TODAY() - 30 AND [Milestone Expected Due Date] < TODAY(), 1, 0) AS [Completed in last 30 Days]
		, IF($([vDaysoverdue]) <= 30, 1, 0)																 AS [Due in last 30 Days]
	FROM [lib://Curated Data Store:DataFiles/10 Landing Area/GPS/Grant Activity Milestone - Old.qvd] (qvd)
	WHERE [Activity Execution State] = 'Executed' AND [Milestone Status] = 'Current'
	AND MATCH([Activity Status], 'Approved', 'Varied', 'Ready for Approval')
	AND ([Activity PBS Program] <> 'DPMC SOETM Services for Other Entities and Trust Monies')
	AND ([Milestone Type] LIKE '*Acquittal*' OR [Milestone Long Description] LIKE '*Acquittal*');


	NOCONCATENATE
	[Milestone Count]:
	LOAD COUNT([Milestone Id]) AS [Milestone Count]
		, [Grant Activity Milestone.Activity Id]	 AS [Activity Id]
	RESIDENT [Grant Activity Milestone]
	GROUP BY [Grant Activity Milestone.Activity Id];

LET vLastYear = NUM(YEAR(TODAY()) - 1);
	[Milestone Overdue Month]:
	LOAD
		  [Milestone Id]										 AS [Milestone Id]
		, [Milestone Payment Mode]								 AS [Overdue Payment Mode]
		, DATE([Outstanding], 'dd/MM/yyyy')						 AS [Milestone Outstanding]
		, REPLACE(YEARNAME([Outstanding], 0, 7), '-20', '-')	 AS [Overdue Milestone Financial Year]
	FROM [lib://Curated Data Store:DataFiles/10 Landing Area/GPS/Milestone Overdue Month.qvd] (qvd);




///$tab Quality
	[Grant Activity Acquittal Error]:
	LOAD
		  [Review Id]	 AS [Review Id]
		, [Error]		 AS [Review Error]
		, [Error Number]	 AS [Error Number]
	FROM [lib://Curated Data Store:DataFiles/10 Landing Area/GPS/Grant Activity Acquittal Error.qvd] (qvd);


//Check for missing acquittals by comparing the number of financial years with the number of reviews 
	FinYearCount:
	LOAD [Grant Activity Id%] AS [Grant Activity Id%]
		, COUNT([Activity Funding Financial Year])	 AS [FundingYrCount]
	RESIDENT [Grant Activity Funding]
	WHERE NUM(LEFT([Activity Funding Financial Year], 4)) > 2016
//Exclude next financial year
	AND NUM(LEFT([Activity Funding Financial Year], 4)) <= NUM(LEFT(YEARNAME(NOW(2), 0, 7), 4))
	GROUP BY [Grant Activity Id%];


	LEFT JOIN
	LOAD [Grant Activity Id%] AS [Grant Activity Id%]
		, [Activity Id]	 AS [Activity Id]
	RESIDENT [Grant Activity];


	[Acquittal Count]:
	LOAD [Activity Id] AS [Activity Id]
		, COUNT([Review Id])	 AS [ReviewCount]
	RESIDENT [Grant Activity Acquittal]
	GROUP BY [Activity Id];


	Stg_MissingAcquittals:
	LOAD [Activity Id] AS [Activity Id]
		, [FundingYrCount]	 AS [FundingYrCount]
	RESIDENT FinYearCount;


	LEFT JOIN
	LOAD [Activity Id] AS [Activity Id]
		, [ReviewCount]	 AS [ReviewCount]
	RESIDENT [Acquittal Count];


	MissingAcquittals:
	LOAD [Activity Id] AS [Activity Id]
		, [FundingYrCount]												 AS [FundingYrCount]
		, [ReviewCount]													 AS [ReviewCount]
		, IF([FundingYrCount] > ALT([ReviewCount], 0), 'Check', 'Ok')	 AS [Potential Missing Acquittal]
	RESIDENT Stg_MissingAcquittals;


	DROP TABLES [Acquittal Count], FinYearCount, Stg_MissingAcquittals;



///$tab Exit
	EXIT SCRIPT;
