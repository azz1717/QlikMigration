[Grant Activity Acquittal]:
LOAD DISTINCT *, 
	IF(ISNULL([Acquittal Total Value (ex GST)]), [Activity Acquittal Total Value (ex GST)],[Acquittal Total Value (ex GST)]) as [Acquittal Forecast Value (ex GST)]
Resident [Grant Activity Acquittal Temp];



Drop Table [Activity Acquittal Amount Temp];


LOAD
    "Grant Activity Acquittal Item.Review Id" As [Review Id],
    "Grant Activity Acquittal Item.Review Title",
    "Grant Activity Acquittal Item.Review Item Number" as [Review Item Number],
    "Grant Activity Acquittal Item.Review Item Question" as [Review Item Question],
    "Grant Activity Acquittal Item.Review Item Answer" as [Review Item Answer],
    "Grant Activity Acquittal Item.Review Item Justification" as [Review Item Justification]
FROM [lib://AppData/PROD/AzureDataLake/GPS/Grant Activity Acquittal Item.qvd]
(qvd);


//Create Master calendar based on reviews/Acquittals
OverdueRevAcquittalDates:
//create a date for each day the review is not complete
    Load *,
    	[Rev End Date] - [Rev Due Date] as "No of Days Open",
    Date([Rev Due Date] + IterNo() - 1) as RevOverdueDate
           	While [Rev Due Date] + IterNo() - 1 <= [Rev End Date];
            // Today();
    Load
     "Review Id",
      [Acquittal Due Date] as [Rev Due Date],
     //set overdue flag
     //If("Review Due Date"< today()  and  not "Review Status" like 'Complete*', 'Y', 'N') as "Overdue Acquittal",
     // check if review is completed
     If([Acquittal Due Date]< today()  and  not "Review Status" like 'Complete*', Today(), 
     	if("Review Status" like 'Complete*',  [Acquittal Status Change Date] )) as [Rev End Date] 
Resident [Grant Activity Acquittal Temp]  //[Dim Review]
//where "Review Status" <> 'Complete' Or  if("Review Status" = 'Complete', "Review Status Change Date") -  "Review Due Date" > 0;
;
MinMax:
Load min(RevOverdueDate) as MinDate,
	Max([Rev End Date]) as MaxDate
Resident OverdueRevAcquittalDates;

Let vMinDate = Peek('MinDate',0,'Min_Max');
Let vMaxDate = Peek('MaxDate',0, 'Min_Max');
Drop Table MinMax;

Temp1:
Load 
Date($(vMinDate) + RowNo() - 1) AS RDay
AutoGenerate (1)
WHILE $(vMinDate) + IterNo() -1 <= $(vMaxDate);



RevFortnightEnding:
Load 
RDay as RevOverdueDate,
'Q' & CEIL(NUM(MONTH([RDay]))/3) AS RevOverdueQuarter,
 Dual('Q'&Num(Ceil(Num(Month(AddMonths(RDay,1-7)))/3)),Num(Ceil(NUM(Month(AddMonths(RDay,1-7)))/3),00)) AS Fiscal_Quarter,
Year(Date(RDay)) as RevOverdueYear,
MonthName(RDay) as RevOverdueMonthYear,
week(RDay) as RevOverdueWeek,
weekend(RDay,0,4) as RevOverdueWeekEnd,
weekyear(RDay) as RevOverdueWeekYear,
yearname(RDay,0,7) as FinancialYear,
If(Mod(Week(RDay,0,7),2)=0, date(WeekEnd(RDay,1,7)), date(WeekEnd(RDay,0,7))) as RevFortnightEnding
Resident Temp1;

DROP table Temp1;
Drop Table [Grant Activity Acquittal Temp];

///$tab Activity
[Grant Activity Temp]:
LOAD
    "Grant Activity.Grant Activity Id%" as [Grant Activity Id%],
    "Grant Activity.Source Organisation Id%" As [Activity Source Organisation Id%],
    IF("Grant Activity.Activity Id" = '4-ENJBSQ2', 'a6c824bf-afc1-e611-80f1-c4346bc5977c',"Grant Activity.PMC Region Id%") as [PMC Region Id%],
	[Grant Activity.Programme Component Id%] AS [Programme Component Id%],
	IF(LEn([Grant Activity.Programme Id%]) = 0, 'ae0b9448-9f69-e611-80e6-c4346bc43f98',[Grant Activity.Programme Id%])  AS [Programme Id%],
//   [Grant Activity.Programme Id%]  AS [Programme Id%],
	[Grant Activity.Sub Programme] AS [Sub Program],
	[Grant Activity.Grant Activity] AS [Activity Title],
//    "Grant Activity.Grant Activity Status",
    "Grant Activity.Activity Id" As [Activity Id],
    "Grant Activity.Activity Description" As [Long Description],
    DATE("Grant Activity.Activity Start Date", 'DD/MM/YYYY') as [Activity Start Date],
    DATE("Grant Activity.Activity End Date", 'DD/MM/YYYY') as [Activity End Date],
    yearname("Grant Activity.Activity End Date", 0,7) as [Activity End Date Fin Year],
    IF("Grant Activity.Activity Start Date" > Today()-30 and "Grant Activity.Activity Start Date"  < today(), 1,0) as [Activity started in last 30 days],
    IF("Grant Activity.Activity End Date" > Today()-30 and "Grant Activity.Activity End Date" < today(), 1,0) as [Activity ended in last 30 days],
//    "Grant Activity.Funding Approved Date",
//    "Grant Activity.Funding Approved By",
    "Grant Activity.Source System Id%",
//    "Grant Activity.Source Activity Status",
    "Grant Activity.Activity Manager" As [Activity Manager],
    lower(Trim("Grant Activity.Activity Manager")) as  [Activity Manager Key],  
    "Grant Activity.Approved On Date",
//    "Grant Activity.Draft Coded By Id%",
//    "Grant Activity.Draft Coded By",
//    "Grant Activity.Draft Approver Reject Code",
//    "Grant Activity.Draft Approver Reject",
//    "Grant Activity.Current Performance Outcome Id%",
//    "Grant Activity.Current Performance Outcome",
//    "Grant Activity.Source Status Group Code",
	[Grant Activity.Source Status Group] AS [Activity Status],
//    "Grant Activity.Mandatory Submission",
    "Grant Activity.Current Ceasing Activity Assessment Id%",
    "Grant Activity.Current Ceasing Activity Assessment"
//    "Grant Activity.Has Review"
FROM [lib://AppDataProd/AzureDataLake/FUSION/Grant Activity.qvd]
(qvd);
//WHERE LEN([Grant Activity.Programme Id%]) <> 0;
Left Join
LOAD
    "Source Organisation.Source Organisation Id%" As [Activity Source Organisation Id%],
    "Source Organisation.Organisation Id%" AS [Activity Organisation Id%]
//    "Source Organisation.Source System Id%",
//    "Source Organisation.Source System",
//     "Source Organisation.Source Organisation Name",
//     "Source Organisation.Legal Entity Id",
//     "Source Organisation.Trading Name",
//     "Source Organisation.ABN",
//     "Source Organisation.Address Line",
//     "Source Organisation.State",
//     "Source Organisation.Postcode",
//     "Source Organisation.Email Address",
//     "Source Organisation.Legal Name",
//     "Source Organisation.Legal Entity Type",
//     "Source Organisation.Source Organisation Status"
FROM [lib://AppDataProd/AzureDataLake/FUSION/Source Organisation.qvd]
(qvd);
Left Join
LOAD
    "Organisation.Organisation Id%" AS [Activity Organisation Id%],
    Organisation.Organisation AS [Activity Organisation],
//    "Organisation.Entity Type Code",
//    "Organisation.Entity Type",
    Organisation.ABN as [Activity ABN],
//    "Organisation.ASIC Number",
//    "Organisation.Email Address",
//    Organisation.City,
//    Organisation.State,
//    Organisation.Postcode,
//    "Organisation.ORP Approved Date",
    "Organisation.ORP Expiry Date" as [Activity ORP Expiry Date],
    IF(ISNULL([Organisation.ORP Risk Rating]), 'Not Rated',IF([Organisation.ORP Expiry Date]<Today(), 'Expired', [Organisation.ORP Risk Rating])) AS [Activity Organisation Risk Profile],  

//    If(IsNull([Organisation.ORP Risk Rating]), 'Not Rated', [Organisation.ORP Risk Rating]) AS [Activity Organisation Risk Profile],
//    "Organisation.Risk Exemption Date",
//    "Organisation.Risk Exemption Justification",
    "Organisation.Risk Exemption Reason" as [Actitivy Risk Exemption Reason],
//    "Organisation.Indigenous Status",
     If(IsNull([Organisation.Indigeneity]) or [Organisation.Indigeneity] = 'Unknown' , 'No', [Organisation.Indigeneity]) AS [Organisation Indigeneity]
//    "Organisation.Indigeneity Effective Date",
//    Organisation.Status
FROM [lib://AppDataProd/AzureDataLake/FUSION/Organisation.qvd]
(qvd);
Left Join
LOAD
	[Programme.Programme Id%] AS [Programme Id%],
	Replace([Programme.Programme],'2.','1.') AS [Program]

 FROM [lib://AppData/PROD\AzureDataLake\FUSION\Programme.qvd]
(qvd);
Left Join
LOAD
	[Programme Component.Programme Component Id%] as [Programme Component Id%],
	[Programme Component.Programme Id%] AS [Programme Id%],
	[Programme Component.Programme Component],
// 	[Programme Component.ECJDM Applicable],
// 	[Programme Component.Appropriation Type],
 	[Programme Component.Outcome Element] AS [Outcome Element]
// 	[Programme Component.Status],
// 	[Programme Component.Alternate Name 1],
// 	[Programme Component.Alternate Name 2],
// 	[Programme Component.Alternate Name 3],
// 	[Programme Component.Alternate Name 4],
// 	[Programme Component.Alternate Name 5]
 FROM [lib://AppData/PROD\AzureDataLake\FUSION\Programme Component.qvd]
(qvd);
LEFT Join
LOAD
    "RGU Team / Section" AS [RGU Team],
    "RGU Location" AS [RGU Location],
    Lower(trim("Name in Grants System")) AS [Activity Manager Key]
FROM [lib://AppData/PROD/AzureDataLake/SSR/RGU Staff.qvd]
(qvd);


[Grant Activity Funding]:
LOAD
// 	[Grant Activity Funding.Grant Activity Funding Id%],
	[Grant Activity Funding.Grant Activity Id%] AS [Grant Activity Id%],
 	[Grant Activity Funding.Financial Year Id%] AS [Financial Year Id%],
// 	[Grant Activity Funding.Source Status Group],
// 	[Grant Activity Funding.Activity Funding],
	[Grant Activity Funding.Funding Amount] as [Total Value (ex GST)],
    [Grant Activity Funding.Funds Released] as [Funds Released (ex GST)]
// 	[Grant Activity Funding.Activity Funding Status]
 FROM [lib://AppData/PROD\AzureDataLake\FUSION\Grant Activity Funding.qvd]
(qvd);
Left Join
LOAD
    "Financial Year.Financial Year Id%" AS [Financial Year Id%],
    "Financial Year.Financial Year" AS [Activity Funding Financial Year]
FROM [lib://AppData/PROD/AzureDataLake/FUSION/Financial Year.qvd]
(qvd);

[Grant Activity]:
LOAD
[Grant Activity Id%],
[Activity Id],
//[PMC Region Id%],
[Activity Organisation Id%],
[Activity Organisation],
[Activity ABN],
[Organisation Indigeneity],
[Activity Organisation Risk Profile],
[Activity ORP Expiry Date],
[Activity Title],
[Activity Status],
IF([Outcome Element] = 'ABA', 'Aboriginals Benefit Account', [Program]) as [Program],
[Sub Program],
[Activity Start Date],
[Activity End Date],
[Activity End Date] - [Activity Start Date] as [Activity Duration],
[Activity Manager],
If(isnull([RGU Team]), 'Not in GMU', [RGU Team]) as [RGU Team],
If(isnull([RGU Location]), 'Not in GMU', [RGU Location]) as [RGU Location],
[Activity started in last 30 days],
[Activity ended in last 30 days],
[Activity End Date Fin Year]

Resident [Grant Activity Temp];

LatestFinYear:
Load *,
	'20' & LatestFinYear-1 & '-'& LatestFinYear as 'Latest Funding Financial Year';
Load [Grant Activity Id%],
max(right([Activity Funding Financial Year], 2)) as LatestFinYear
Resident [Grant Activity Funding]
group by [Grant Activity Id%];

