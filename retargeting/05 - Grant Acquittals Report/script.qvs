///$tab Region
RegionMap:
Mapping Load  *
INLINE [Region, Group
	Adelaide - GMU, Central
	Alice Springs - GMU,Central
    Arnhem Land & Groote Eylandt, Central
    Darwin - GMU,	Central
    Central Australia,	Central
    Top End & Tiwi Islands,	Central
    Brisbane - GMU,	Eastern
    Cairns - GMU,	Eastern
    Dubbo - GMU,	Eastern
    Mount Isa - GMU,	Eastern
    Orange - GMU,	Eastern
    Parramatta - GMU,	Eastern
    Tamworth - GMU,	Eastern
    Townsville - GMU,	Eastern
    Eastern NSW,	Eastern
    Eastern New South Wales, Eastern
    Western New South Wales, Eastern
    North Queensland,	Eastern
    South Queensland,	Eastern
    Eastern New South Wales,  Eastern
    Western NSW,	Eastern
    Broome - GMU,	National Office
    Canberra - GMU,	National Office
    Coffs Harbour - GMU,	National Office
    National Office,	National Office
    Adelaide - GMU,	West and South
    Melbourne - GMU,	West and South
    Perth - GMU,	West and South
    Greater Western Australia,	West and South
    Kimberley, West and South
    South Australia,	West and South
    Victoria & Tasmania,	West and South
    GMU Central Support - GMU, National Office
];

[Grant Managing Region]:

LOAD
    "Grant Activity Id%",
    "NIAA Region Id%" AS [PMC Region Id%],
    "GMU Region Id%",
    "Engegement Officer",
    "Source System"
FROM [lib://AppData/PROD/AzureDataLake/GPS/Grant Managing Region.qvd]
(qvd);

[NIAA Region]:
Load *,
	applymap('RegionMap',[NIAA Region]) as Group;
LOAD
    "PMC Region.PMC Region Id%" AS [PMC Region Id%],
//    "PMC Region.PMC Region Code",
    IF(match("PMC Region.PMC Region Abbr", 'FNQLD', 'GNQLD'), "PMC Region.PMC Region") AS [NIAA Sub Region],
    IF(match("PMC Region.PMC Region Abbr", 'FNQLD', 'GNQLD'), "PMC Region.PMC Region Abbr") AS [NIAA Sub Region Abbr],
    IF(match("PMC Region.PMC Region Abbr", 'FNQLD', 'GNQLD'), 'North Queensland', "PMC Region.PMC Region") AS [NIAA Region],
    IF(match("PMC Region.PMC Region Abbr", 'FNQLD', 'GNQLD'), 'NQ', "PMC Region.PMC Region Abbr") AS "PMC Region.PMC Region Abbr",
    
    "PMC Region.State",
//    "PMC Region.Regional Manager",
//    "PMC Region.Regional Manager Email",
//    "PMC Region.Regional Manager Business Phone",
//    "PMC Region.Regional Manager Mobile"

IF("PMC Region.PMC Region Abbr" = 'GWA' or "PMC Region.PMC Region Abbr" = 'KIM' or "PMC Region.PMC Region Abbr" = 'SA' or "PMC Region.PMC Region Abbr" = 'VIC/TAS', 'West & South Group',
IF("PMC Region.PMC Region Abbr" = 'CA' or "PMC Region.PMC Region Abbr" = 'TETI' or "PMC Region.PMC Region Abbr" = 'ALGE', 'Central Group',
IF("PMC Region.PMC Region Abbr" = 'ENSW' or "PMC Region.PMC Region Abbr" = 'WNSW' or "PMC Region.PMC Region Abbr" = 'SQLD' 
	or "PMC Region.PMC Region Abbr" = 'FNQLD' or "PMC Region.PMC Region Abbr" = 'GNQLD', 'Eastern Group','National'))) as "NIAA Region Group"



FROM [lib://AppDataProd/AzureDataLake/FUSION/PMC Region.qvd]
(qvd);

[GMU Region]:

LOAD
    "PMC Region.PMC Region Id%" AS [GMU Region Id%],
	
    
    "PMC Region.State" as [GMU State],

IF("PMC Region.PMC Region Abbr" = 'GWA' or "PMC Region.PMC Region Abbr" = 'KIM' or "PMC Region.PMC Region Abbr" = 'SA' or "PMC Region.PMC Region Abbr" = 'VIC/TAS', 'West & South Group',
IF("PMC Region.PMC Region Abbr" = 'CA' or "PMC Region.PMC Region Abbr" = 'TETI' or "PMC Region.PMC Region Abbr" = 'ALGE', 'Central Group',
IF("PMC Region.PMC Region Abbr" = 'ENSW' or "PMC Region.PMC Region Abbr" = 'WNSW' or "PMC Region.PMC Region Abbr" = 'SQLD' or "PMC Region.PMC Region Abbr" = 'FNQLD' 
	or "PMC Region.PMC Region Abbr" = 'GNQLD', 'Eastern Group','National'))) as "GMU Region Group"


FROM [lib://AppDataProd/AzureDataLake/FUSION/PMC Region.qvd]
(qvd);
///$tab Milestone
[Grant Activity Milestone]:

Let vDaysoverdue = 'IF([Grant Activity Milestone.Milestone Expected Due Date] <= today(), Today() - [Grant Activity Milestone.Milestone Expected Due Date])' ;
Let vEndDate = text('2014-06-30');


//left keep([Grant Activity Acquittal])
LOAD 	$(vDaysoverdue) as [Number of Days Milestone Overdue]		
		,[Grant Activity Milestone.Activity Id] 
      ,Replace(YearName([Grant Activity Milestone.Milestone Expected Due Date],0,7), '-20','-') as "Milestone Financial Year"
      ,[Grant Activity Milestone.Activity PBS Program] as [Activity PBS Outcome]
      ,[Grant Activity Milestone.Managing Office - Activity] AS [Milestone Managing Office%]
      ,[Grant Activity Milestone.Milestone Id] AS [Milestone Id]
      ,[Grant Activity Milestone.Milestone Status] AS [Grant Activity Milestone.Milestone Status]
      ,IF([Grant Activity Milestone.Milestone Expected Due Date] > Today(), 'Overdue',  [Grant Activity Milestone.Milestone Stage]) AS [Grant Activity Milestone.Milestone Stage]
      ,[Grant Activity Milestone.Milestone Completed Indicator] AS [Milestone Completed Indicator]
      ,[Grant Activity Milestone.Milestone Payment Mode] AS [Milestone Payment Mode]
      ,[Grant Activity Milestone.Milestone Received] AS [Grant Activity Milestone.Milestone Received]
      ,[Grant Activity Milestone.Milestone Short Description] AS [Grant Activity Milestone.Milestone Short Description]
      ,[Grant Activity Milestone.Milestone Long Description] AS [Milestone Long Description]
      ,[Grant Activity Milestone.Milestone Completion Description] AS [Milestone Completion Description] 
      ,[Grant Activity Milestone.Milestone Type] AS [Milestone Type]
       ,(Floor(([Grant Activity Milestone.Milestone Completion Date] - [Grant Activity Milestone.Milestone Expected Due Date])/30) * 30)+30 as [Days to Complete]
      ,[Grant Activity Milestone.Milestone Expected Due Date] AS [Milestones Expected Due Date]
      ,[Grant Activity Milestone.Financial Year Name] AS [Grant Activity Milestone.Financial Year Name]
      ,[Grant Activity Milestone.Milestone Action Required] AS [Grant Activity Milestone.Milestone Action Required]
      ,[Grant Activity Milestone.Milestone Completion Date] AS [Milestone Completion Date]
      ,[Grant Activity Milestone.Activity IMPACT PO Id] AS [Grant Activity Milestone.Activity IMPACT PO Id]
      ,[Grant Activity Milestone.Milestone Auto Release Indicator] AS [Grant Activity Milestone.Milestone Auto Release Indicator]
      ,[Grant Activity Milestone.Milestone Date Driven Indicator] AS [Grant Activity Milestone.Milestone Date Driven Indicator]
      ,[Grant Activity Milestone.Milestone Actual Amount Ex GST] AS [Milestone Actual Amount Ex GST],
     IF([Grant Activity Milestone.Milestone Expected Due Date] > Today(), 0, 1) AS [Overdue by Date],
      IF([Grant Activity Milestone.Milestone Expected Due Date] <= Today(), 
        IF([Grant Activity Milestone.Milestone Stage] = 'Future','Overdue - Not received',
        	IF([Grant Activity Milestone.Milestone Stage] = 'Overdue', 'Overdue - Not received',
        	IF([Grant Activity Milestone.Milestone Stage] = 'Received', 'Overdue - Received'))),
      IF([Grant Activity Milestone.Milestone Expected Due Date] > Today(),
        	IF([Grant Activity Milestone.Milestone Stage] = 'Future', 'Future - Not received',
        		IF([Grant Activity Milestone.Milestone Stage] = 'Overdue', 'Future - Not received',
        			IF([Grant Activity Milestone.Milestone Stage] = 'Received',  'Future - Received'))))
         ) AS [Stage],
      IF([Grant Activity Milestone.Milestone Expected Due Date] < Today() + 30 and [Grant Activity Milestone.Milestone Expected Due Date] > Today(), 1, 0) AS [Due in next 30 Days],
      IF([Grant Activity Milestone.Milestone Expected Due Date] < Today() + 180 and [Grant Activity Milestone.Milestone Expected Due Date] > Today(), 1, 0) AS [Due in next 6 Months],
      IF([Grant Activity Milestone.Milestone Expected Due Date] < Today() + 60 and [Grant Activity Milestone.Milestone Expected Due Date] > Today() + 30, 1, 0) AS [Due in next 60 Days],
      IF([Grant Activity Milestone.Milestone Completion Date] > Today() - 30 and [Grant Activity Milestone.Milestone Expected Due Date] < Today(), 1, 0) AS [Completed in last 30 Days],
      IF($(vDaysoverdue) <= 30, 1,0) AS [Due in last 30 Days]

FROM [lib://AppData/PROD/AzureDataLake/SSR/Grant Activity Milestone.qvd]
(qvd)
WHERE [Grant Activity Milestone.Activity Execution State] = 'Executed' and [Grant Activity Milestone.Milestone Status] = 'Current' 
AND Match([Grant Activity Milestone.Activity Status], 'Approved' , 'Varied' , 'Ready for Approval')
and ([Grant Activity Milestone.Activity PBS Program] <>  'DPMC SOETM Services for Other Entities and Trust Monies')
and ([Grant Activity Milestone.Milestone Type] like '*Acquittal*' or [Grant Activity Milestone.Milestone Long Description] like '*Acquittal*');

NoConcatenate
[Milestone Count]:
Load Count([Milestone Id]) as [Milestone Count],
	[Grant Activity Milestone.Activity Id] As [Activity Id]
Resident [Grant Activity Milestone]
group by [Grant Activity Milestone.Activity Id]; 
 
 Let vLastYear = NUM(Year(Today())-1);
 [Milestone Overdue Month]:
 LOAD
 [Milestone Id],
 [Milestone Payment Mode] as [Overdue Payment Mode],
	DATE(Outstanding, 'dd/MM/yyyy') as "Milestone Outstanding",
	Replace(YearName(Outstanding,0,7), '-20','-') as "Overdue Milestone Financial Year"
  FROM [lib://AppData/PROD/AzureDataLake/SSR/Milestone Overdue Month.qvd]
 (qvd);




///$tab Quality
[Grant Activity Acquittal Error]:
LOAD
    "Grant Activity Acquittal Error.Review Id" as [Review Id],
    "Grant Activity Acquittal Error.Error" as [Review Error],
    "Grant Activity Acquittal Error.Error Number" as [Error Number]
FROM [lib://AppData/PROD/AzureDataLake/GPS/Grant Activity Acquittal Error.qvd]
(qvd);

//Check for missing acquittals by comparing the number of financial years with the number of reviews 
FinYearCount:
Load [Grant Activity Id%],
count([Activity Funding Financial Year]) as FundingYrCount
Resident [Grant Activity Funding]
where num(left([Activity Funding Financial Year],4)) > 2016
//Exclude next financial year
and  num(left([Activity Funding Financial Year],4)) <= num(left(yearname(now(2),0,7),4))
group by [Grant Activity Id%];
left Join
Load [Grant Activity Id%],
[Activity Id]
Resident [Grant Activity];



[Acquittal Count]:
Load "Activity Id",
Count("Review Id") as ReviewCount
Resident [Grant Activity Acquittal]
Group By "Activity Id";

Stg_MissingAcquittals:
Load [Activity Id],
	FundingYrCount
resident FinYearCount;
left Join 
Load [Activity Id],
	ReviewCount
Resident [Acquittal Count]
 ;

MissingAcquittals:
Load [Activity Id],
	FundingYrCount,
    ReviewCount,
    if(FundingYrCount > alt(ReviewCount,0), 'Check', 'Ok') as "Potential Missing Acquittal"
Resident Stg_MissingAcquittals;
	


drop tables [Acquittal Count], FinYearCount, Stg_MissingAcquittals;



///$tab Exit
exit script;