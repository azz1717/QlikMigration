//Fix managing region, duplicates in tables
//DESE activities not in fusion causing the manging office to duplicate. Solution ; move managing region calc to load script?
// maybe rationalise offices in description. Talk  to Nicole

//Changes
//Fixed acquittal amounts and counts on summary sheet
//fixed amounts and colours on open acquittals by groups sheet.
//restricted  milestones on the details sheet to milestones linked to an acquittal
//removed milestone processing not used in the table. the code is commented out and should be deleted if not required.
//added tool tip to data quality bar chart showing error.



///$tab Update Date
[Load Date]:
LOAD
    "Data Source Code",
    "Siebel Cut Off Date Time",
    "Warehouse Load Time"
FROM [lib://AppDataProd/AzureDataLake/GPS/GPS Data Warehouse Load Time.qvd]
(qvd);
///$tab Acquittal
[Activity Acquittal Amount Temp]:
LOAD
    "Grant Activity.Grant Activity Id%" as [Grant Activity Id%],
    "Grant Activity.Activity Id" As [Temp Activity Id]
FROM [lib://AppDataProd/AzureDataLake/FUSION/Grant Activity.qvd]
(qvd);
LEFT JOIN
LOAD
	[Grant Activity Funding.Grant Activity Id%] AS [Grant Activity Id%],
 	[Grant Activity Funding.Financial Year Id%] AS [Financial Year Id%],
	[Grant Activity Funding.Funding Amount] as [Total Value (ex GST)],
    [Grant Activity Funding.Funds Released] as [Funds Released (ex GST)]
 FROM [lib://AppData/PROD\AzureDataLake\FUSION\Grant Activity Funding.qvd]
(qvd);
LEFT JOIN
LOAD
    "Financial Year.Financial Year Id%" AS [Financial Year Id%],
    "Financial Year.Financial Year" AS [Activity Financial Year]
FROM [lib://AppData/PROD/AzureDataLake/FUSION/Financial Year.qvd]
(qvd);

[Grant Activity Acquittal Temp]:
Load *,
	 if([Temp Acquittal Office] like '*North*', mid( [Temp Acquittal Office], Index(  [Temp Acquittal Office],'North',1)), [Temp Acquittal Office]) as "Acquittal Office";
Load *,
	 IF([Acquittal Due Date] <= today(), 
     	IF([Acquittal Status] <> 'Complete' , TODAY(),[Acquittal Completion Date] ) - [Acquittal Due Date]) as "Acquittal Days to Completion",
    IF([Acquittal Due Date] > TODAY()-30 and [Acquittal Due Date] < TODAY(), 1, 0) AS 'Acquittal Due in Last 30 Days',
    IF([Acquittal Due Date] < TODAY() + 30 and [Acquittal Due Date] > TODAY(), 1, 0) AS 'Acquittal Due in Next 30 Days',
    IF([Acquittal Status] like '*Complete*' and [Acquittal Completion Date] > TODAY(0)- 8 and [Acquittal Completion Date] < TODAY(), 1,0) as 'Acquittal Completed in Last 7 Days',  
    if(match([Review Status] , 'Draft','Scheduled'/*'In Progress', */) and [Acquittal Status Change Date] > Today(0)-8 , 1, 0)  as 'Acquittal Created in Last 7 Days',
    trim(Left( [Abbrev Milestone Group],Index( [Abbrev Milestone Group],'20',1)-2 )) as "Temp Acquittal Office"
;
LOAD [Grant Activity Acquittal.Activity Id] as [Activity Id], 
	[Grant Activity Acquittal.Milestone Id] as [Milestone Id], 
	[Grant Activity Acquittal.Review Id] as [Review Id], 
    [Grant Activity Acquittal.Activity Id]&Replace([Grant Activity Acquittal.Review Financial Year],'-20','-') as [Activity Acquittal Amount%],
	[Grant Activity Acquittal.Review Title],
	Replace([Grant Activity Acquittal.Review Financial Year],'-20','-') as [Acquittal Financial Year],
//	[Grant Activity Acquittal.Acquittal Status] as [Acquittal Status],
//     IF([Grant Activity Acquittal.Review Status] = 'Complete Pending Activities' , 'Complete', 
//     	IF([Grant Activity Acquittal.Review Status] = 'In Progress' OR [Grant Activity Acquittal.Review Status] ='Planned' 
// 			OR [Grant Activity Acquittal.Review Status]= 'Received - In Progress' OR [Grant Activity Acquittal.Review Status]= 'Scheduled' 
// 			OR [Grant Activity Acquittal.Review Status]= 'Submitted' , 'Due', 
//         	[Grant Activity Acquittal.Review Status] ))  as [Acquittal Status],
//      if([Grant Activity Acquittal.Review Status] like 'Complete*'   , 'Complete', 
// 		if([Grant Activity Acquittal.Review Due Date] > Today(),'Future', 'Due')) as [Acquittal Status],
	[Grant Activity Acquittal.Review Stage] as [Acquittal Status],
    [Grant Activity Acquittal.Review Status] as [Review Status],
	[Grant Activity Acquittal.Review Due Date] as [Acquittal Due Date],
//     IF([Grant Activity Acquittal.Review Due Date] > today(), NULL(), IF([Grant Activity Acquittal.Review Status] = 'Complete' 
//		OR [Grant Activity Acquittal.Review Status] = 'Complete Pending Activities', [Grant Activity Acquittal.Review Status Change Date], TODAY()) - [Grant Activity Acquittal.Review Due Date]) 
		//as "Acquittal Days to Completion",
//     IF([Grant Activity Acquittal.Review Due Date] > TODAY()-30 and [Grant Activity Acquittal.Review Due Date] < TODAY(), 1, 0) AS 'Acquittal Due in Last 30 Days',
//     IF([Grant Activity Acquittal.Review Due Date] < TODAY() + 30 and [Grant Activity Acquittal.Review Due Date] > TODAY(), 1, 0) AS 'Acquittal Due in Next 30 Days',
	[Grant Activity Acquittal.Review Start Date],
	[Grant Activity Acquittal.Review End Date],
	[Grant Activity Acquittal.Milestone Review Grouping Name] as [Milestone Review Grouping Name],
	[Grant Activity Acquittal.Review Status Change Date] as [Acquittal Status Change Date],
    IF([Grant Activity Acquittal.Review Status] like '*Complete*', [Grant Activity Acquittal.Review Status Change Date]) as [Acquittal Completion Date],
    Yearname(IF([Grant Activity Acquittal.Review Status] like '*Complete*', [Grant Activity Acquittal.Review Status Change Date]),0,7) as [Acquittal Completion Financial Year],
    
    NUM([Grant Activity Acquittal.Acquittal Amount]) as [Acquittal Total Value (ex GST)],
//    IF(NUM([Grant Activity Acquittal.Acquittal Amount]) <= 0, 1, 0) as [Acquittal Amount Not Entered],
	[Grant Activity Acquittal.Review Item Justification],
	[Grant Activity Acquittal.Review Result Findings] as [Review Result Findings],
	[Grant Activity Acquittal.Review Result Type] as [Review Result Type],
	[Grant Activity Acquittal.Review Authorised By],
	[Grant Activity Acquittal.Review Type],
	[Grant Activity Acquittal.Review Subtype],
    replace(mid( [Grant Activity Acquittal.Milestone Review Grouping Name], Index( [Grant Activity Acquittal.Milestone Review Grouping Name],'Acquittal',1)+10 ), '&' ,'and') as "Abbrev Milestone Group"
//	[Grant Activity Acquittal.Activity End Date]
FROM [lib://AppData\PROD\AzureDataLake\GPS\Grant Activity Acquittal.qvd] (qvd)

Where not match([Grant Activity Acquittal.Review Status], 'Cancelled') ;

LEFT JOIN
LOAD
[Temp Activity Id]&[Activity Financial Year] as [Activity Acquittal Amount%],
NUM([Total Value (ex GST)]) as [Activity Acquittal Total Value (ex GST)]
Resident [Activity Acquittal Amount Temp];




